<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoRent"
        mc:Ignorable="d"
        Title="AutoRent - Fleet &amp; Dispatch Management"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F4F3F1"
        FontFamily="Manrope, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Maroon" Color="#70000F"/>
        <SolidColorBrush x:Key="MaroonSubtle" Color="#F7E9EB"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#2B2927"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#363331"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#3D3A37"/>
        <SolidColorBrush x:Key="NavText" Color="#B5AFA9"/>
        <SolidColorBrush x:Key="NavTextActive" Color="#FFFFFF"/>

        <Geometry x:Key="CarIcon">M18.92,6.01C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.29,5.42 5.08,6.01L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6.01M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M5,11L6.5,6.5H17.5L19,11H5Z</Geometry>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource NavText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Height="44" Background="Transparent">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="8,0,8,0"/>
                            <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left"
                                    Background="{StaticResource Maroon}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="25,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Ico" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Collapsed">
                                <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Root" Property="ToolTip" Value="{Binding Title}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHover}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource NavTextActive}"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="#C0394B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Maroon}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8A0016"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarLink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NavText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" Grid.ColumnSpan="2" Width="72" HorizontalAlignment="Left" Panel.ZIndex="10" Background="{StaticResource SidebarBg}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88"/>   
                    <RowDefinition Height="*"/>    
                    <RowDefinition Height="Auto"/> 
                    <RowDefinition Height="Auto"/> 
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                        <Button x:Name="LogoToggle" Style="{StaticResource LogoButton}" Width="38" Height="38" Margin="0,0,12,0"
                                ToolTip="Expand / collapse sidebar">
                            <Path Data="{StaticResource CarIcon}" Fill="White" Stretch="Uniform"
                                  Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel x:Name="BrandText" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="AUTORENT" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="CurrentViewBadgeText" Text="ADMIN CONSOLE" FontSize="9.5"
                                       FontWeight="SemiBold" Foreground="#C0394B" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" Grid.Row="1" Margin="0,16,0,0" Tag="Collapsed"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"/>

                <Button x:Name="SwitchViewButton" Grid.Row="2" Style="{StaticResource SidebarLink}"
                        Margin="19,0,0,10" Visibility="Collapsed" ToolTip="Switch view">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SwitchIcon" Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Width="34" TextAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SwitchText" Text="Preview Client View" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>

                <Border Grid.Row="3" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,1,0,0" Padding="19,16,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#4A4643" CornerRadius="17" Width="34" Height="34" Margin="0,0,12,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="UserText" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="UsernameDisplay" Text="User" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="UserRoleDisplay" Text="ROLE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#8A847E" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>



                        <Button x:Name="LogoutButton" Style="{StaticResource SidebarLink}" Foreground="#E0707F" ToolTip="Sign Out">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Width="34" TextAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LogoutLabel" Text="Sign Out" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContentHost" Grid.Column="1" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
