<Window x:Class="AutoRent.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car Rental Management - Login" Height="660" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F3F1"
        FontFamily="Manrope, Segoe UI" ResizeMode="NoResize">

    <Window.Resources>

        <SolidColorBrush x:Key="Maroon" Color="#70000F"/>
        <SolidColorBrush x:Key="MaroonDark" Color="#58000C"/>
        <SolidColorBrush x:Key="InkBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#B9B9B9"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#E2E0DD"/>

        <Geometry x:Key="CarIcon">M18.92,6.01C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.29,5.42 5.08,6.01L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6.01M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M5,11L6.5,6.5H17.5L19,11H5Z</Geometry>

        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Maroon}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A4A4A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarePasswordBox" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Maroon}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MaroonDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45000A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" Background="White"
                                    BorderBrush="#7A7A7A" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="1.8"
                                      Visibility="Collapsed" Stretch="Uniform" Margin="2"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Maroon}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="57*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" ClipToBounds="True">

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                        <GradientStop Color="#15191D" Offset="0"/>
                        <GradientStop Color="#2A2F33" Offset="0.45"/>
                        <GradientStop Color="#6B4A2E" Offset="0.8"/>
                        <GradientStop Color="#E59A3A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#55000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.4"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="64,66,0,0">
                <Path Data="{StaticResource CarIcon}" Fill="White" Stretch="Uniform" Width="30" Height="30" VerticalAlignment="Center"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CAR RENTAL MANAGEMENT SYSTEM" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="DISPATCH &amp; INSPECTION SYSTEM" Foreground="#C8C8C8" FontSize="9" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="56,0,40,70">
                <TextBlock Text="Precision in" Foreground="White" FontSize="52" FontWeight="Light" LineHeight="58"/>
                <TextBlock Text="Every Journey." Foreground="White" FontSize="52" FontWeight="SemiBold" LineHeight="58"/>
                <TextBlock Foreground="#E6E6E6" FontSize="15" FontWeight="Light" TextWrapping="Wrap"
                           Margin="2,22,0,0" MaxWidth="440" LineHeight="26"
                           Text="A smarter way to manage fleet operations, daily dispatch, and vehicle inspections."/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="#F4F3F1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" BorderThickness="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="335" Margin="0,40,0,20">

                    <Path Data="{StaticResource CarIcon}" Fill="{StaticResource Maroon}" Stretch="Uniform"
                          Width="44" Height="44" HorizontalAlignment="Center"/>
                    <TextBlock Text="CAR RENTAL MANAGEMENT" FontSize="9" FontWeight="SemiBold" Foreground="#3A3A3A"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="DISPATCH &amp; INSPECTION SYSTEM" FontSize="8.5" Foreground="#9A9A9A"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <Rectangle Height="1" Width="44" Fill="#D9D7D4" Margin="0,28,0,0"/>

                    <TextBlock Text="Welcome Back" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center" Margin="0,36,0,0"/>
                    <TextBlock Text="Sign in to access your workspace." FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,40,0,8"/>
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B5B5B5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UsernamePlaceholder" Grid.Column="1" Text="Enter your username"
                                       Foreground="{StaticResource PlaceholderBrush}" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="UsernameTextBox" Grid.Column="1" Style="{StaticResource BareTextBox}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,24,0,8"/>
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B5B5B5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PasswordPlaceholder" Grid.Column="1" Text="Enter your password"
                                       Foreground="{StaticResource PlaceholderBrush}" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Style="{StaticResource BarePasswordBox}"/>
                            <TextBox x:Name="PasswordRevealBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                                     Visibility="Collapsed"/>
                            <Button x:Name="TogglePasswordButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                    Focusable="False">
                                <TextBlock x:Name="EyeIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <CheckBox x:Name="RememberMeCheckBox" Content="Remember Me" Style="{StaticResource SquareCheck}"
                                  HorizontalAlignment="Left"/>
                    </Grid>

                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Height="54" Margin="0,26,0,0"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SIGN IN" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="12,1,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Visibility="Collapsed">
                        <Hyperlink x:Name="RegisterLink">Don't have an account? Register</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Width="335" Margin="0,0,0,26" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="#E3E1DE" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="AUTHORIZED PERSONNEL ONLY" FontSize="8.5" Foreground="#C2C0BD"
                           Margin="14,0" VerticalAlignment="Center"/>
                <Rectangle Grid.Column="2" Height="1" Fill="#E3E1DE" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
