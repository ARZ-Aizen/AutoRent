<UserControl x:Class="Presentation.Views.Admin.RateManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="1180"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoRent;component/Presentation/UI/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>
            <SolidColorBrush x:Key="UserIdRed" Color="#9E1C2E"/>

            <Style x:Key="RateActionPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandMaroon}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandMaroonHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RateDataGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#FAFAFA"/>
                <Setter Property="Foreground" Value="#5F6368"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
            </Style>

            <Style x:Key="RateDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FAF8F5"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F7E9EB"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DangerOutlineButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#F28B82"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FDF2F2"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E57373"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F4F3F1">
        <Grid Margin="32,18,32,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Rate Management" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B"/>
                        <TextBlock Text="Set prices per vehicle category. Every vehicle in a category uses that category's rates."
                                   FontSize="12.5" Foreground="#7A746D" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnOverrideInfo" Style="{StaticResource OutlineButton}"
                                Height="36" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                Click="BtnOverrideInfo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vehicle override guide" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAddTier" Style="{StaticResource OutlineButton}"
                                Height="36" Padding="14,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                Click="BtnAddTier_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Tier" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCreateRule" Style="{StaticResource RateActionPrimaryButton}"
                                VerticalAlignment="Center" Click="BtnCreateRule_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Create rate rule" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                            Padding="20,16,20,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Base rate tiers · PHP" FontSize="16" FontWeight="Bold" Foreground="#2B2927"/>
                                    <TextBlock Text="Category baseline pricing and unit overrides" FontSize="11.5" Foreground="#7A746D" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button x:Name="BtnEditTiers" DockPanel.Dock="Right" Content="Edit tiers" Style="{StaticResource OutlineButton}"
                                        Height="30" Padding="14,0" FontSize="12" VerticalAlignment="Center" Click="BtnEditTiers_Click"/>
                            </DockPanel>

                            <Border BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8">
                                <DataGrid x:Name="DgRateTiers" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F0EEEB" Background="White" RowBackground="White"
                                          BorderThickness="0" RowHeight="40" Height="205" SelectionMode="Single" SelectionUnit="FullRow"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ColumnHeaderStyle="{StaticResource RateDataGridHeaderStyle}"
                                          RowStyle="{StaticResource RateDataGridRowStyle}"
                                          SelectionChanged="DgRateTiers_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Category" Width="1.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="12.5"
                                                               Foreground="{StaticResource BrandMaroon}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Daily" Width="0.9*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayDaily}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="#2B2927" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Weekly · 7 days" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayWeekly}" FontSize="12.5"
                                                               Foreground="#5F6368" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Monthly · 30 days" Width="1.3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayMonthly}" FontSize="12.5"
                                                               Foreground="#5F6368" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Vehicle override" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VehicleOverride}" FontSize="12"
                                                               Foreground="#3C4043" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <TextBlock Text="Vehicle override replaces category base. VH-0004 ₱520/day · VH-0184 ₱480/day. Weekly and monthly tiers replace, not stack with, daily pricing."
                                       FontSize="11" Foreground="#7A746D" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                            Padding="20,18,20,16">
                        <StackPanel>
                            <TextBlock Text="Booking rate preview" FontSize="16" FontWeight="Bold" Foreground="#2B2927"/>
                            <TextBlock x:Name="TxtPreviewSubtitle" Text="Sedan · 17-19 Oct 2026 · 2 weekend days"
                                       FontSize="11.5" Foreground="#7A746D" Margin="0,3,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="TxtPreviewBaseLabel" Text="Base · 2 × ₱450" FontSize="12.5" Foreground="#4A4642"/>
                                <TextBlock x:Name="TxtPreviewBaseVal" Text="₱900.00" FontSize="12.5" FontWeight="SemiBold" Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="TxtPreviewUpliftLabel" Text="Weekend uplift · ×1.15" FontSize="12.5" Foreground="#4A4642"/>
                                <TextBlock x:Name="TxtPreviewUpliftVal" Text="+₱135.00" FontSize="12.5" FontWeight="SemiBold" Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Child seat · 2 × ₱15" FontSize="12.5" Foreground="#4A4642"/>
                                <TextBlock Text="+₱30.00" FontSize="12.5" FontWeight="SemiBold" Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border BorderBrush="#E8E5E1" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Eligible booking total" FontSize="12.5" Foreground="#4A4642" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPreviewTotalVal" Text="₱1,065.00" FontSize="16" FontWeight="Bold" Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#FDF2F2" BorderBrush="#FAD2D2" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <TextBlock Text="Vehicle override → duration tier → holiday OR weekend → fees → approved discount. No multiplier stacking."
                                           FontSize="11" Foreground="#9E1C2E" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                        Padding="20,16,20,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Pricing rules" FontSize="16" FontWeight="Bold" Foreground="#2B2927"/>
                                <TextBlock Text="Effective dates in branch timezone · select a rule to inspect or amend"
                                           FontSize="11.5" Foreground="#7A746D" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#FDF2F2" BorderBrush="#FAD2D2" BorderThickness="1"
                                    CornerRadius="12" Padding="10,3.5" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRulesSummary" Text="8 active / 1 inactive"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#9E1C2E"/>
                            </Border>
                        </DockPanel>

                        <Border Grid.Row="1" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8">
                            <DataGrid x:Name="DgPricingRules" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F0EEEB" Background="White" RowBackground="White"
                                      BorderThickness="0" RowHeight="42" SelectionMode="Single" SelectionUnit="FullRow"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ColumnHeaderStyle="{StaticResource RateDataGridHeaderStyle}"
                                      RowStyle="{StaticResource RateDataGridRowStyle}"
                                      SelectionChanged="DgPricingRules_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Rule name" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{StaticResource BrandMaroon}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Category" Width="0.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Category}" FontSize="12.5"
                                                           Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Effective start / end" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EffectiveDates}" FontSize="12"
                                                           Foreground="#5F6368" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Calculation method" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CalculationMethod}" FontSize="12.5"
                                                           Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Rate / multiplier" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RateMultiplier}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Status" Width="0.9*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,2.5" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F3F4"/>
                                                            <Setter Property="BorderBrush" Value="#E8EAED"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#E6F4EA"/>
                                                                    <Setter Property="BorderBrush" Value="#CEEAD6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#5F6368"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#137333"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Last modified by / time" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastModified}" FontSize="12"
                                                           Foreground="#3C4043" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                        Padding="16,10" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Finalized contracts are protected" FontSize="12.5" FontWeight="Bold" Foreground="#2B2927"/>
                        <TextBlock Text="Rate updates apply to new eligible bookings only. Equal-priority date overlaps are rejected; holiday pricing takes precedence over weekend pricing. Every update records old/new values, approver and effective time."
                                   FontSize="11" Foreground="#7A746D" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        <Grid x:Name="EditTiersModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtTierModalTitle" Text="Edit Base Rate Tier" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                    <TextBlock x:Name="TxtTierModalSubtitle" Text="Customize pricing and overrides for this vehicle category" FontSize="12" Foreground="#7A746D" Margin="0,2,0,16"/>

                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalCategory" Height="36" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DAILY RATE (₱)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModalDaily" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="WEEKLY RATE (₱)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModalWeekly" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MONTHLY RATE (₱)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModalMonthly" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DEPOSIT (₱)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModalDeposit" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LATE FEE / DAY (₱)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModalLateFee" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VEHICLE OVERRIDE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModalOverride" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Vehicle override assigns a custom daily rate for a specific vehicle (e.g. VH-0001 · ₱450/day)."
                               FontSize="11" Foreground="#7A746D" Margin="0,0,0,18"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="90" Click="BtnCloseTiersModal_Click"/>
                        <Button x:Name="BtnDeleteTier" DockPanel.Dock="Left" Content="Delete Tier" Style="{StaticResource DangerOutlineButton}"
                                Width="100" Margin="10,0,0,0" Click="BtnDeleteTier_Click"/>
                        <Button x:Name="BtnSaveTierSubmit" DockPanel.Dock="Right" Content="Save Changes" Style="{StaticResource PrimaryButton}"
                                Width="120" Click="BtnSaveTiers_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="VehicleOverrideInfoModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Vehicle Override Explanation" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                    <TextBlock Text="How individual vehicle overrides interact with category base rates" FontSize="12" Foreground="#7A746D" Margin="0,2,0,16"/>

                    <Border Background="#F9F8F7" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="1. Category Base Rate (Default)" FontWeight="SemiBold" FontSize="13" Foreground="#70000F" Margin="0,0,0,4"/>
                            <TextBlock Text="Every vehicle in a category (e.g. all Sedans) automatically inherits that category's standard base daily rate."
                                       FontSize="12" Foreground="#4A4642" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,12"/>

                            <TextBlock Text="2. Vehicle Override (Specific Unit Exception)" FontWeight="SemiBold" FontSize="13" Foreground="#70000F" Margin="0,0,0,4"/>
                            <TextBlock Text="When a particular vehicle has special features (e.g. brand-new 2026 unit, premium leather trim, or specialized accessories), administrators can assign a Vehicle Override (e.g. VH-0001 · ₱450/day)."
                                       FontSize="12" Foreground="#4A4642" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,12"/>

                            <TextBlock Text="3. Calculation Order &amp; Priority" FontWeight="SemiBold" FontSize="13" Foreground="#70000F" Margin="0,0,0,4"/>
                            <TextBlock Text="Vehicle Override takes top priority in the pricing engine. It replaces the category base rate completely for that specific vehicle before duration tiers, weekend/holiday multipliers, and optional add-ons are calculated."
                                       FontSize="12" Foreground="#4A4642" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="Got it" Style="{StaticResource PrimaryButton}"
                                Width="100" Click="BtnCloseOverrideInfo_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="CreateRuleModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Create Rate Rule" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                    <TextBlock Text="Configure pricing adjustment, multiplier, or add-on fee" FontSize="12" Foreground="#7A746D" Margin="0,2,0,16"/>

                    <TextBlock Text="RULE ID &amp; NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewRuleName" Height="36" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbNewRuleCategory" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RATE / MULTIPLIER" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewRuleMultiplier" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="CALCULATION METHOD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewRuleMethod" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="EFFECTIVE DATES" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewRuleDates" Height="36" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkNewRuleActive" Content="Rule is currently active" IsChecked="True"
                              FontSize="12.5" Margin="0,0,0,20"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="90" Click="BtnCloseRuleModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Create Rule" Style="{StaticResource PrimaryButton}"
                                Width="120" Click="BtnSaveNewRule_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="InspectRuleModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtInspectTitle" Text="Rule Details" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                    <TextBlock x:Name="TxtInspectSubtitle" Text="Inspect and modify pricing calculation rule" FontSize="12" Foreground="#7A746D" Margin="0,2,0,16"/>

                    <TextBlock Text="RULE NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInspectRuleName" Height="36" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtInspectCategory" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RATE / MULTIPLIER" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtInspectMultiplier" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="CALCULATION METHOD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInspectMethod" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="EFFECTIVE DATES" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInspectDates" Height="36" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkInspectActive" Content="Rule is currently active"
                              FontSize="12.5" Margin="0,0,0,20"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Close" Style="{StaticResource OutlineButton}"
                                Width="90" Click="BtnCloseInspectModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Save Changes" Style="{StaticResource PrimaryButton}"
                                Width="120" Click="BtnSaveInspectRule_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
