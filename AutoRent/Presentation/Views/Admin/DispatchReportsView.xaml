<UserControl x:Class="Presentation.Views.Admin.DispatchReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="960" d:DesignWidth="1180"
             FontFamily="Manrope, Segoe UI"
             Background="#F8F8F8">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoRent;component/Presentation/UI/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>
            <SolidColorBrush x:Key="BookingLinkRed" Color="#9E1C2E"/>

            <!-- Metric Card Base -->
            <Style x:Key="KpiCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="MinHeight" Value="100"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.03" Color="#000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom Header Style for DataGrid -->
            <Style x:Key="ReportTableHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F8F7F5"/>
                <Setter Property="Foreground" Value="#5C5750"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Custom Cell Style -->
            <Style x:Key="ReportTableCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border Background="{TemplateBinding Background}" Padding="14,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                        <Setter Property="Foreground" Value="#70000F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Row Style -->
            <Style x:Key="ReportTableRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="Height" Value="46"/>
                <Setter Property="MinHeight" Value="46"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F4F1"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Pagination button base -->
            <Style x:Key="PageBtn" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White"
                                    BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F6F5F3"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D0CBC5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Page Heading -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20" VerticalAlignment="Center">
                    <TextBlock Text="Daily Dispatch Reports" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B"/>
                    <TextBlock x:Name="TxtHeaderSubtitle"
                               Text="14 Oct 2026 · HQ branch · concise timestamps in branch timezone · last prepared at 17:05"
                               FontSize="12.5" Foreground="#7A746D" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ROW 1: 7 Top Metric Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Scheduled Dispatches -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Scheduled Dispatches" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatScheduled" Text="15" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock x:Name="TxtStatScheduledNote" Text="12 out · 1 cancelled · 2 pending" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: Completed Check-Outs -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Completed Check-Outs" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatCheckouts" Text="12" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock Text="Today's departures" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 3: Completed Returns -->
                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Completed Returns" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatReturns" Text="8" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock Text="Today's returns" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 4: Cancelled Reservations -->
                    <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Cancelled Reservations" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatCancelled" Text="1" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock Text="Before release" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 5: Overdue Returns -->
                    <Border Grid.Column="8" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Overdue Returns" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatOverdue" Text="3" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock x:Name="TxtStatOverdueNote" Text="Included in active rentals" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 6: Vehicles Not Dispatched -->
                    <Border Grid.Column="10" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Vehicles Not Dispatched" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatPending" Text="2" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock Text="Scheduled, still pending" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 7: Fleet Utilization -->
                    <Border Grid.Column="12" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Fleet Utilization" FontSize="11" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatUtilization" Text="69.6%" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,4,0,2"/>
                                <TextBlock x:Name="TxtStatUtilizationNote" Text="128 / 184 vehicles" FontSize="10" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 2: 4 Filters Bar -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8"
                        Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Report Date -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Report date" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbReportDate" Height="36" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Vehicle / Plate -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vehicle / plate" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbVehicleFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Assigned Clerk -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Assigned clerk" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbClerkFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Contract Status -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Contract status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbStatusFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 3: Dispatch Register Card & Table -->
                <Border Grid.Row="3" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                        Padding="0" ClipToBounds="True" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Register Header -->
                        <Border Padding="20,16,20,14" Background="White" BorderBrush="#E8E5E1" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Dispatch register" FontSize="16" FontWeight="Bold" Foreground="#1F1D1B"/>
                                    <TextBlock x:Name="TxtRegisterSubtitle"
                                               Text="Date + 24-hour time · — means not yet recorded · selected BK-9841"
                                               FontSize="12" Foreground="#7A746D" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- DataGrid Table -->
                        <DataGrid x:Name="DgDispatchRegister"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  RowHeight="46"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0EEEB"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternationCount="2"
                                  ColumnHeaderStyle="{StaticResource ReportTableHeader}"
                                  CellStyle="{StaticResource ReportTableCell}"
                                  RowStyle="{StaticResource ReportTableRow}"
                                  SelectionMode="Single"
                                  SelectionChanged="DgDispatchRegister_SelectionChanged">

                            <DataGrid.Columns>
                                <!-- Booking ID -->
                                <DataGridTemplateColumn Header="Booking ID" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookingId}" FontWeight="Bold" FontSize="12.5"
                                                       Foreground="{StaticResource BookingLinkRed}" Cursor="Hand" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Vehicle ID -->
                                <DataGridTemplateColumn Header="Vehicle ID" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VehicleIdDisplay}" FontSize="12.5" Foreground="#5C5750" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Plate -->
                                <DataGridTemplateColumn Header="Plate" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Plate}" FontWeight="SemiBold" FontSize="12.5" Foreground="#2B2927" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Customer -->
                                <DataGridTemplateColumn Header="Customer" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" FontSize="12.5" Foreground="#2B2927" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Assigned Clerk -->
                                <DataGridTemplateColumn Header="Assigned Clerk" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AssignedClerk}" FontSize="12.5" Foreground="#4A453E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Scheduled Pickup -->
                                <DataGridTemplateColumn Header="Scheduled Pickup" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ScheduledPickupDisplay}" FontSize="12" Foreground="#4A453E" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actual Dispatch Timestamp -->
                                <DataGridTemplateColumn Header="Actual Dispatch Timestamp" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActualDispatchDisplay}" FontSize="12" Foreground="#5C5750" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Expected Return -->
                                <DataGridTemplateColumn Header="Expected Return" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ExpectedReturnDisplay}" FontSize="12" Foreground="#4A453E" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actual Return Timestamp -->
                                <DataGridTemplateColumn Header="Actual Return Timestamp" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActualReturnDisplay}" FontSize="12" Foreground="#5C5750" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Contract Status -->
                                <DataGridTemplateColumn Header="Contract Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBgColor}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ContractStatus}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding StatusFgColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Register Bottom Pagination Footer -->
                        <Border BorderBrush="#E8E5E1" BorderThickness="0,1,0,0" Padding="20,12" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtPagingRecords"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="#7A746D"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnPrev" Style="{StaticResource PageBtn}" Click="BtnPrev_Click" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#7A746D"/>
                                    </Button>

                                    <ItemsControl x:Name="IcPages">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Button x:Name="BtnNext" Style="{StaticResource PageBtn}" Click="BtnNext_Click">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#7A746D"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ROW 4: Side-by-Side Detail Cards -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Selected Dispatch Preview -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10" Padding="22,18">
                        <StackPanel>
                            <TextBlock x:Name="TxtSelectedTitle" Text="Selected dispatch · BK-9841" FontSize="15" FontWeight="Bold" Foreground="#1F1D1B"/>
                            <TextBlock Text="Authorized detailed-record preview" FontSize="11.5" Foreground="#7A746D" Margin="0,2,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Vehicle / clerk" FontSize="11.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailVehicleClerk" Text="VH-0001 / Andrei Balboa" FontSize="12.5" FontWeight="Bold" Foreground="#2B2927" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Contract / Payment -->
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Contract / payment" FontSize="11.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailContractPayment" Text="Closed / TX-1001 paid" FontSize="12.5" FontWeight="Bold" Foreground="#2B2927" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Checkout / return inspection -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Checkout / return inspection" FontSize="11.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailInspection" Text="IN-0419 / IN-0420" FontSize="12.5" FontWeight="Bold" Foreground="#2B2927" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Post-return fleet status -->
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Post-return fleet status" FontSize="11.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailPostStatus" Text="Available" FontSize="12.5" FontWeight="Bold" Foreground="#137333" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnViewRecord"
                                    Style="{StaticResource OutlineButton}"
                                    Height="32"
                                    Padding="14,0"
                                    HorizontalAlignment="Left"
                                    Click="BtnViewRecord_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="View authorized record" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Safety Overrides Warning Notice -->
                    <Border Grid.Column="2" Background="#FEF7ED" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Safety overrides are not permitted" FontSize="13.5" FontWeight="Bold" Foreground="#92400E"/>
                            <TextBlock Text="Unresolved maintenance, an incomplete inspection or an invalid contract blocks dispatch. Detailed records and exports are role protected and audited."
                                       FontSize="11.5" Foreground="#78350F" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
