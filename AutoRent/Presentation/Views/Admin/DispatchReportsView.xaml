<UserControl x:Class="Presentation.Views.Admin.DispatchReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1180"
             FontFamily="Manrope, Segoe UI"
             Background="#F8F8F8">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoRent;component/Presentation/UI/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>
            <SolidColorBrush x:Key="BookingLinkRed" Color="#9E1C2E"/>

            <!-- Metric Card Base (Squeezed for viewport fit) -->
            <Style x:Key="KpiCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="MinHeight" Value="76"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.03" Color="#000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom Header Style for DataGrid -->
            <Style x:Key="ReportTableHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F8F7F5"/>
                <Setter Property="Foreground" Value="#5C5750"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Custom Cell Style -->
            <Style x:Key="ReportTableCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border Background="{TemplateBinding Background}" Padding="12,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                        <Setter Property="Foreground" Value="#70000F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Row Style (Compact 36px) -->
            <Style x:Key="ReportTableRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F4F1"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Pagination button base (Compact 30px) -->
            <Style x:Key="PageBtn" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White"
                                    BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F6F5F3"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D0CBC5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="26,12,26,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Page Heading & Action Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Daily Dispatch Reports" FontSize="22" FontWeight="Bold" Foreground="#1F1D1B"/>
                        <TextBlock x:Name="TxtHeaderSubtitle"
                                   Text="14 Oct 2026 · HQ branch · concise timestamps in branch timezone · last prepared at 17:05"
                                   FontSize="11.5" Foreground="#7A746D" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPrintReport"
                                Style="{StaticResource OutlineButton}"
                                Height="32"
                                Padding="13,0"
                                ToolTip="Print daily dispatch report"
                                Click="BtnPrintReport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Print Report" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- ROW 1: 7 Top Metric Cards (Squeezed to fit without scrolling) -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Scheduled Dispatches -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Scheduled Dispatches" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatScheduled" Text="15" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock x:Name="TxtStatScheduledNote" Text="12 out · 1 cancelled" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: Completed Check-Outs -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Completed Check-Outs" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatCheckouts" Text="12" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock Text="Today's departures" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 3: Completed Returns -->
                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Completed Returns" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatReturns" Text="8" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock Text="Today's returns" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 4: Cancelled Reservations -->
                    <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cancelled Reservations" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatCancelled" Text="1" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock Text="Before release" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 5: Overdue Returns -->
                    <Border Grid.Column="8" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Overdue Returns" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatOverdue" Text="3" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock x:Name="TxtStatOverdueNote" Text="Active rentals" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 6: Vehicles Not Dispatched -->
                    <Border Grid.Column="10" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Vehicles Not Dispatched" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatPending" Text="2" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock Text="Pending release" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Card 7: Fleet Utilization -->
                    <Border Grid.Column="12" Style="{StaticResource KpiCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Fleet Utilization" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B665F" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtStatUtilization" Text="69.6%" FontSize="21" FontWeight="Bold" Foreground="#70000F" Margin="0,1,0,1"/>
                                <TextBlock x:Name="TxtStatUtilizationNote" Text="128 / 184 vehicles" FontSize="9.5" Foreground="#8B8588" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E1C2E" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 2: Balanced 4 Filters Bar (Height squeezed) -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8"
                        Padding="14,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Report Date -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Report date" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbReportDate" Height="30" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Vehicle / Plate -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vehicle / plate" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbVehicleFilter" Height="30" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Assigned Clerk -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Assigned clerk" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbClerkFilter" Height="30" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Contract Status -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Contract status" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbStatusFilter" Height="30" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 3: Dispatch Register Card & Table (Compact Height) -->
                <Border Grid.Row="3" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                        Padding="0" ClipToBounds="True" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Register Header -->
                        <Border Padding="16,8,16,8" Background="White" BorderBrush="#E8E5E1" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Dispatch register" FontSize="14.5" FontWeight="Bold" Foreground="#1F1D1B"/>
                                    <TextBlock x:Name="TxtRegisterSubtitle"
                                               Text="Date + 24-hour time · — means not yet recorded · selected BK-9841"
                                               FontSize="11" Foreground="#7A746D" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- DataGrid Table -->
                        <DataGrid x:Name="DgDispatchRegister"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  RowHeight="35"
                                  MinHeight="288"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0EEEB"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternationCount="2"
                                  ColumnHeaderStyle="{StaticResource ReportTableHeader}"
                                  CellStyle="{StaticResource ReportTableCell}"
                                  RowStyle="{StaticResource ReportTableRow}"
                                  SelectionMode="Single"
                                  SelectionChanged="DgDispatchRegister_SelectionChanged">

                            <DataGrid.Columns>
                                <!-- Booking ID -->
                                <DataGridTemplateColumn Header="Booking ID" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookingId}" FontWeight="Bold" FontSize="11.5"
                                                       Foreground="{StaticResource BookingLinkRed}" Cursor="Hand" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Vehicle ID -->
                                <DataGridTemplateColumn Header="Vehicle ID" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VehicleIdDisplay}" FontSize="11.5" Foreground="#5C5750" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Plate -->
                                <DataGridTemplateColumn Header="Plate" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Plate}" FontWeight="SemiBold" FontSize="11.5" Foreground="#2B2927" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Customer -->
                                <DataGridTemplateColumn Header="Customer" Width="1.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" FontSize="11.5" Foreground="#2B2927" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Assigned Clerk -->
                                <DataGridTemplateColumn Header="Assigned Clerk" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AssignedClerk}" FontSize="11.5" Foreground="#4A453E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Scheduled Pickup -->
                                <DataGridTemplateColumn Header="Scheduled Pickup" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ScheduledPickupDisplay}" FontSize="11" Foreground="#4A453E" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actual Dispatch Timestamp -->
                                <DataGridTemplateColumn Header="Actual Dispatch" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActualDispatchDisplay}" FontSize="11" Foreground="#5C5750" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Expected Return -->
                                <DataGridTemplateColumn Header="Expected Return" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ExpectedReturnDisplay}" FontSize="11" Foreground="#4A453E" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actual Return Timestamp -->
                                <DataGridTemplateColumn Header="Actual Return" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActualReturnDisplay}" FontSize="11" Foreground="#5C5750" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Contract Status -->
                                <DataGridTemplateColumn Header="Contract Status" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBgColor}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ContractStatus}" FontWeight="SemiBold" FontSize="10.5" Foreground="{Binding StatusFgColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Register Bottom Pagination Footer (Compact) -->
                        <Border BorderBrush="#E8E5E1" BorderThickness="0,1,0,0" Padding="16,6" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtPagingRecords"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#7A746D"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnPrev" Style="{StaticResource PageBtn}" Click="BtnPrev_Click" Margin="0,0,5,0">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Foreground="#7A746D"/>
                                    </Button>

                                    <ItemsControl x:Name="IcPages">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Button x:Name="BtnNext" Style="{StaticResource PageBtn}" Click="BtnNext_Click">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Foreground="#7A746D"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ROW 4: Balanced Side-by-Side Operational Cards (Compact) -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Selected Dispatch Preview -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedTitle" Text="Selected dispatch · BK-9841" FontSize="13.5" FontWeight="Bold" Foreground="#1F1D1B"/>
                                    <TextBlock Text="Authorized detailed-record preview &amp; verification" FontSize="10.5" Foreground="#7A746D" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnViewRecord"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource OutlineButton}"
                                        Height="28"
                                        Padding="12,0"
                                        VerticalAlignment="Center"
                                        Click="BtnViewRecord_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="View audit record" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Vehicle / clerk -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Vehicle / clerk" FontSize="10.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailVehicleClerk" Text="VH-0001 / Andrei Balboa" FontSize="11.5" FontWeight="Bold" Foreground="#2B2927" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Contract / payment -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Contract / payment" FontSize="10.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailContractPayment" Text="Closed / TX-1001 paid" FontSize="11.5" FontWeight="Bold" Foreground="#2B2927" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Booking status -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Booking status" FontSize="10.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailBookingState" Text="—" FontSize="11.5" FontWeight="Bold" Foreground="#2B2927" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Post-return fleet status -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Post-return fleet status" FontSize="10.5" Foreground="#7A746D"/>
                                    <TextBlock x:Name="TxtDetailPostStatus" Text="Available" FontSize="11.5" FontWeight="Bold" Foreground="#137333" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Safety & Compliance Controls (Compact) -->
                    <Border Grid.Column="2" Background="#FEF7ED" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
