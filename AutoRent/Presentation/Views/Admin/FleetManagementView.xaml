<UserControl x:Class="Presentation.Views.Admin.FleetManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1170"
             FontFamily="Segoe UI"
             Background="#F7F6F5">

    <UserControl.Resources>

        <SolidColorBrush x:Key="Burgundy" Color="#76091F"/>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderBrush" Value="#E8E5E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#383436"/>
            <Setter Property="BorderBrush" Value="#DDD9D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"
                    Value="{StaticResource Burgundy}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource Burgundy}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5E595A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FleetGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="61"/>
            <Setter Property="ColumnHeaderHeight" Value="39"/>
            <Setter Property="AlternatingRowBackground" Value="#FCFBFB"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#383235"/>

            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F3F2"/>
                        <Setter Property="Foreground" Value="#777072"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="9,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="9,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1EEEE"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="23,21,23,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Fleet Inventory"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#302D2E"/>
                <TextBlock x:Name="TxtSummary"
                           Text="Loading vehicle records..."
                           FontSize="11"
                           Foreground="#827C7D"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="＋  Add Vehicle"
                        Style="{StaticResource PrimaryButton}"
                        Click="Add_Click"/>

            </StackPanel>
        </Grid>

        <!-- FILTER BAR -->
        <Border Grid.Row="1"
                Style="{StaticResource Panel}"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search fleet"
                               Style="{StaticResource FieldCaption}"/>

                    <TextBox x:Name="TxtSearch"
                             Height="35"
                             FontSize="12"
                             Padding="9,8"
                             BorderBrush="#E0DCDD"
                             BorderThickness="1"
                             ToolTip="Search vehicle ID, plate, make, or model"
                             TextChanged="Search_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Category"
                               Style="{StaticResource FieldCaption}"/>

                    <ComboBox x:Name="CmbCategoryFilter"
                              Height="35"
                              FontSize="12"
                              VerticalContentAlignment="Center"
                              BorderBrush="#E0DCDD"
                              SelectionChanged="Selection_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Current status"
                               Style="{StaticResource FieldCaption}"/>

                    <ComboBox x:Name="CmbStatusFilter"
                              Height="35"
                              FontSize="12"
                              VerticalContentAlignment="Center"
                              BorderBrush="#E0DCDD"
                              SelectionChanged="Selection_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Sort by"
                               Style="{StaticResource FieldCaption}"/>

                    <ComboBox x:Name="CmbSort"
                              Height="35"
                              FontSize="12"
                              VerticalContentAlignment="Center"
                              BorderBrush="#E0DCDD"
                              SelectionChanged="Selection_Changed">

                        <ComboBoxItem Content="Make A–Z"
                                      Tag="make ASC, model ASC"/>

                        <ComboBoxItem Content="Model A–Z"
                                      Tag="model ASC, make ASC"/>

                        <ComboBoxItem Content="Year newest first"
                                      Tag="model_year DESC, make ASC"/>

                        <ComboBoxItem Content="Year oldest first"
                                      Tag="model_year ASC, make ASC"/>

                        <ComboBoxItem Content="Daily rate highest"
                                      Tag="daily_rate DESC, make ASC"/>

                        <ComboBoxItem Content="Daily rate lowest"
                                      Tag="daily_rate ASC, make ASC"/>

                        <ComboBoxItem Content="Plate number"
                                      Tag="plate ASC"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VEHICLE REGISTER -->
        <Border Grid.Row="2"
                Style="{StaticResource Panel}"
                Padding="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,13,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Vehicle register"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#302D2E"/>

                        <TextBlock x:Name="TxtRegisterSummary"
                                   FontSize="11"
                                   Foreground="#8C8587"
                                   Text="Vehicle records"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F9E8EC"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTotalBadge"
                                   Foreground="#76091F"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- VEHICLE TABLE -->
                <Grid Grid.Row="1">
                <DataGrid
                          x:Name="DgVehicles"
                          Style="{StaticResource FleetGrid}"
                          Margin="8,0"
                          MinHeight="130"
                          MaxHeight="620"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="Grid_DoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Vehicle ID"
                                            Binding="{Binding display_id}"
                                            Width="90"
                                            MinWidth="85"/>

                        <!-- VEHICLE PHOTO / NAME -->
                        <DataGridTemplateColumn Header="Vehicle"
                                                Width="2*"
                                                MinWidth="190">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Border Width="61"
                                                Height="44"
                                                CornerRadius="5"
                                                ClipToBounds="True"
                                                Background="#F1EFEE"
                                                Margin="0,0,10,0">

                                            <Grid>
                                                <TextBlock Text="NO PHOTO"
                                                           Foreground="#A29B9D"
                                                           FontSize="8"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                <Image Source="{Binding image_source}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel VerticalAlignment="Center"
                                                    MaxWidth="200">
                                            <TextBlock Text="{Binding make}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#292627"
                                                       FontSize="12"/>

                                            <TextBlock Text="{Binding model}"
                                                       Foreground="#777173"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Plate number"
                                            Binding="{Binding plate}"
                                            Width="110"
                                            MinWidth="103"/>

                        <DataGridTextColumn Header="Year"
                                            Binding="{Binding model_year}"
                                            Width="65"
                                            MinWidth="60"/>

                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding category}"
                                            Width="1.45*"
                                            MinWidth="140"/>

                        <DataGridTextColumn Header="Mileage (km)"
                                            Binding="{Binding mileage, StringFormat=N0}"
                                            Width="110"
                                            MinWidth="104"/>

                        <DataGridTextColumn Header="Daily rate"
                                            Binding="{Binding daily_rate, StringFormat='₱{0:N2}'}"
                                            Width="95"
                                            MinWidth="94"/>

                        <!-- STATUS BADGE -->
                        <DataGridTemplateColumn Header="Status"
                                                Width="110"
                                                MinWidth="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusPill"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Padding="9,3.5"
                                            Background="#F1F0F0">
                                        <TextBlock x:Name="StatusLabel"
                                                   Text="{Binding status}"
                                                   FontSize="11"
                                                   Foreground="#686365"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding status}"
                                                     Value="Available">
                                            <Setter TargetName="StatusPill"
                                                    Property="Background"
                                                    Value="#E8F3EB"/>
                                            <Setter TargetName="StatusLabel"
                                                    Property="Foreground"
                                                    Value="#267447"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding status}"
                                                     Value="Rented">
                                            <Setter TargetName="StatusPill"
                                                    Property="Background"
                                                    Value="#F1EFF1"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding status}"
                                                     Value="Reserved">
                                            <Setter TargetName="StatusPill"
                                                    Property="Background"
                                                    Value="#FFF5DF"/>
                                            <Setter TargetName="StatusLabel"
                                                    Property="Foreground"
                                                    Value="#916013"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding status}"
                                                     Value="Maintenance">
                                            <Setter TargetName="StatusPill"
                                                    Property="Background"
                                                    Value="#FBEAEA"/>
                                            <Setter TargetName="StatusLabel"
                                                    Property="Foreground"
                                                    Value="#A23636"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ROW ACTIONS -->
                        <DataGridTemplateColumn Header="Actions"
                                                Width="135"
                                                MinWidth="130">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Button Content="View"
                                                Padding="10,6"
                                                Height="30"
                                                Style="{StaticResource ActionButton}"
                                                Click="ViewRow_Click"
                                                Margin="0,0,5,0"/>

                                        <Button Content="Edit"
                                                Padding="10,6"
                                                Height="30"
                                                Style="{StaticResource ActionButton}"
                                                Click="EditRow_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TxtEmptyFleet"
                           Text="No matching vehicles. Try clearing the search or changing the filters."
                           Foreground="#817B7D"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="400"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
                </Grid>

                <!-- PAGINATION -->
                <Grid Grid.Row="2" Margin="15,12,15,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtPageInfo"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#837D7F"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button x:Name="BtnPrevious"
                                Content="‹"
                                Width="36"
                                Height="33"
                                Style="{StaticResource ActionButton}"
                                Click="Previous_Click"
                                Margin="0,0,5,0"/>

                        <Border Background="#76091F"
                                CornerRadius="5"
                                Padding="12,7"
                                Margin="0,0,5,0">
                            <TextBlock x:Name="TxtCurrentPage"
                                       Text="1"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock x:Name="TxtPageCount"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#797375"
                                   Margin="0,0,9,0"/>

                        <Button x:Name="BtnNext"
                                Content="›"
                                Width="36"
                                Height="33"
                                Style="{StaticResource ActionButton}"
                                Click="Next_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>

</UserControl>
