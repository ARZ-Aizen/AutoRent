<UserControl x:Class="Presentation.Views.Admin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="1180"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoRent;component/Presentation/UI/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>
            <SolidColorBrush x:Key="UserIdRed" Color="#9E1C2E"/>

            <Style x:Key="CreateUserButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandMaroon}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandMaroonHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TableActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#D9D5D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F5F4F1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#BFBBB5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerOutlineButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#F28B82"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FDF2F2"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E57373"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F4F3F1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,28">

            <DockPanel Margin="0,0,0,20" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="MANAGEMENT &amp; CONFIGURATION"
                               FontSize="10.5" FontWeight="Bold" Foreground="#8A847E" Margin="0,0,0,3"/>
                    <TextBlock Text="User Management / User Account Management"
                               FontSize="13.5" FontWeight="Bold" Foreground="#2B2927"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#D9D5D0" BorderThickness="1"
                            CornerRadius="16" Height="32" Width="210" Margin="0,0,20,0" Padding="8,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11.5" Foreground="#7A746D" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtGlobalSearch"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="12" VerticalAlignment="Center"
                                     Padding="0" Text="Search records..." Foreground="#7A746D"
                                     GotFocus="TxtGlobalSearch_GotFocus" LostFocus="TxtGlobalSearch_LostFocus"
                                     TextChanged="TxtGlobalSearch_TextChanged"/>
                            <Border Grid.Column="2" Background="#F1EFEA" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                <TextBlock Text="⌘ K" FontSize="9.5" FontWeight="SemiBold" Foreground="#7A746D"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="TxtHeaderDay" Text="WEDNESDAY" FontSize="9" FontWeight="Bold"
                                   Foreground="#8A847E" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtHeaderDate" Text="14 Oct 2026" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#2B2927" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Border Background="Transparent" Width="32" Height="32" CornerRadius="16"
                            Margin="0,0,12,0" Cursor="Hand" ToolTip="Notifications">
                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#5F6368" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Background="#F9F8F6" BorderBrush="#E0DCD7" BorderThickness="1"
                            CornerRadius="16" Height="32" Padding="2,2,8,2" Cursor="Hand" ToolTip="Signed in as Alex Morgan">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#4A2E35" Width="26" Height="26" CornerRadius="13" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtAvatarInitials" Text="AM" FontSize="10.5" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="#5F6368" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,0,0,18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="User Account Management" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B"/>
                    <TextBlock x:Name="TxtHeaderStats"
                               Text="8 staff accounts · 6 active · 1 invitation pending · 1 deactivated · passwords are never displayed"
                               FontSize="12.5" Foreground="#7A746D" Margin="0,4,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" x:Name="BtnOpenCreateUser"
                        Style="{StaticResource CreateUserButtonStyle}" VerticalAlignment="Center"
                        Click="BtnOpenCreateUser_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Create User" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                    Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Search staff" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="TxtSearchStaff" Height="36" Padding="8,0"
                                     FontSize="12.5" VerticalContentAlignment="Center"
                                     TextChanged="FilterInputs_Changed"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="Name, username or user ID..."
                                       Foreground="#9E9892" FontSize="12.5" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbRoleFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Branch" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbBranchFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Account status" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbStatusFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                    Padding="20,18,20,14" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Staff directory" FontSize="16" FontWeight="Bold"
                                   Foreground="#2B2927" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="#FCE8E6" BorderBrush="#FAD2CF" BorderThickness="1"
                                CornerRadius="12" Padding="10,3.5" VerticalAlignment="Center">
                            <TextBlock Text="Admin-only account changes" FontSize="11" FontWeight="SemiBold" Foreground="#C5221F"/>
                        </Border>
                    </DockPanel>

                    <DataGrid x:Name="DgStaff" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0EEEB" Background="White" RowBackground="White"
                              BorderThickness="0" RowHeight="46" SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="DgStaff_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FAFAFA"/>
                                <Setter Property="Foreground" Value="#5F6368"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FAF8F5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F7E9EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="User ID" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding user_code}" FontWeight="Bold" FontSize="12.5"
                                                   Foreground="{StaticResource UserIdRed}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Full Name" Width="1.35*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding full_name}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="#2B2927" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Username" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding username}" FontSize="12.5"
                                                   Foreground="#5F6368" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Role" Width="1.75*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding display_role}" FontSize="12.5"
                                                   Foreground="#2B2927" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Branch" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding branch}" FontSize="12.5"
                                                   Foreground="#5F6368" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Account Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadgeBorder" CornerRadius="12" Padding="8,2.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="StatusBadgeText" Text="{Binding status_badge}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding status_badge}" Value="Active">
                                                <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#E6F4EA"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="#CEEAD6"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#137333"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding status_badge}" Value="Deactivated">
                                                <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#F1F3F4"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="#E8EAED"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#5F6368"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding status_badge}" Value="Invite pending">
                                                <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEF7E0"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="#FEEFC3"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#B06000"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Last Login" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding last_login_formatted}" FontSize="12"
                                                   Foreground="#3C4043" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TableActionButtonStyle}"
                                                Content="{Binding action_text}"
                                                Click="BtnRowAction_Click"
                                                Tag="{Binding user_id}"
                                                Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Margin="12,14,12,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtShowingCount"
                                   Text="Showing 8 of 8 accounts · access restricted to authorized administrators"
                                   FontSize="11.5" Foreground="#7A746D"/>
                        <TextBlock DockPanel.Dock="Right" Text="Page 1 of 1 · All records shown"
                                   FontSize="11.5" Foreground="#7A746D"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1"
                        CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock x:Name="TxtSelTitle" Text="Selected account · Maya Chen"
                                   FontSize="15" FontWeight="Bold" Foreground="#2B2927"/>
                        <TextBlock x:Name="TxtSelSubtitle"
                                   Text="USR-0008 · secure invitation pending after account update"
                                   FontSize="11.5" Foreground="#7A746D" Margin="0,2,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Current role" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtSelRole" Text="Rental Clerk" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Invitation" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtSelInvite" Text="Issued 14 Oct · 11:26" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#F0EEEB" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="Last activity" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="TxtSelActivity" Text="BK-9841 · 14 Oct, 08:05" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#2B2927" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#F0EEEB" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="Account authority" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="TxtSelAuthority" Text="HQ branch only" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#2B2927" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="BtnSelToggleActive" Style="{StaticResource DangerOutlineButton}"
                                    Content="Deactivate" Margin="0,0,10,0" Click="BtnSelToggleActive_Click"/>

                            <Button x:Name="BtnSelResetPass" Style="{StaticResource OutlineButton}"
                                    Margin="0,0,10,0" Click="BtnSelResetPass_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Secure password reset" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnSelActivity" Style="{StaticResource OutlineButton}"
                                    Content="View account activity" Click="BtnSelActivity_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0">
                    <TextBlock Text="Secure account lifecycle" FontWeight="SemiBold" Foreground="#5F6368" FontSize="12.5"/>
                    <TextBlock FontSize="11.5" Foreground="#7A746D" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"
                               Text="Deactivation revokes access but preserves attribution. Password resets use a single-use expiring link, never a stored password. Role changes require server-side authorization and an audit entry."/>
                </StackPanel>
            </Grid>

            <DockPanel Margin="0,8,0,4" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Demonstration data · Fictional records only"
                           Foreground="#C62828" FontWeight="Bold" FontSize="11"/>
                <TextBlock DockPanel.Dock="Right" Text="Northbridge Executive Rentals · HQ branch · USD · UTC+01:00"
                           Foreground="#8A847E" FontSize="11"/>
            </DockPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="CreateUserModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="CreateModalBackdrop_MouseDown"/>

            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="500" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Create Staff Account" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                            <TextBlock Text="Set credentials, assign role and branch authority" FontSize="12" Foreground="#7A746D"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                FontSize="12" Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnCloseCreateModal_Click"/>
                    </DockPanel>

                    <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewFullName" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewUsername" Height="36" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbNewRole" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BRANCH" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbNewBranch" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="INITIAL TEMPORARY PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtNewPassword" Height="36"/>
                        <Button Grid.Column="2" Content="Generate" Style="{StaticResource OutlineButton}"
                                Height="36" Click="BtnGeneratePassword_Click"/>
                    </Grid>

                    <CheckBox x:Name="ChkNewActive" Content="Send activation / invite link (Account is active)"
                              IsChecked="True" Margin="0,4,0,20"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="100" Click="BtnCloseCreateModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Create Account" Style="{StaticResource PrimaryButton}"
                                Width="130" Click="BtnSaveNewUser_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ResetPassModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ResetPassBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtResetPassTitle" Text="Reset Account Password" FontSize="17" FontWeight="Bold" Foreground="#2B2927"/>
                    <TextBlock x:Name="TxtResetPassSub" Text="Enter a new password of at least 8 characters or generate one."
                               FontSize="12" Foreground="#7A746D" Margin="0,4,0,16"/>

                    <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtResetNewPassword" Height="36"/>
                        <Button Grid.Column="2" Content="Generate" Style="{StaticResource OutlineButton}"
                                Height="36" Click="BtnGenerateResetPassword_Click"/>
                    </Grid>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="90" Click="BtnCloseResetModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Apply Password" Style="{StaticResource PrimaryButton}"
                                Width="130" Click="BtnSaveResetPass_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ActivityModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ActivityBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtActivityTitle" Text="Account Activity"
                                   FontSize="17" FontWeight="Bold" Foreground="#2B2927"/>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                FontSize="12" Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnCloseActivityModal_Click"/>
                    </DockPanel>

                    <TextBlock x:Name="TxtActivitySub" Text="Security audit and recent recorded actions"
                               FontSize="12" Foreground="#7A746D" Margin="0,0,0,14"/>

                    <Border Background="#F9F8F6" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtActivityLog1" Text="• BK-9841 reservation dispatched at 14 Oct, 08:05" FontSize="12" Foreground="#2B2927" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtActivityLog2" Text="• Successfully authenticated via HQ desktop terminal" FontSize="12" Foreground="#5F6368" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtActivityLog3" Text="• Security credentials verified (PBKDF2 SHA-256)" FontSize="12" Foreground="#5F6368"/>
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Right" Content="Close" Style="{StaticResource OutlineButton}"
                            Width="90" Click="BtnCloseActivityModal_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
