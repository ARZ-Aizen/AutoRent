<UserControl x:Class="Presentation.Views.Admin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="1180"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoRent;component/Presentation/UI/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>
            <SolidColorBrush x:Key="UserIdRed" Color="#9E1C2E"/>

            <Style x:Key="CreateUserButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandMaroon}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandMaroonHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TableActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#D9D5D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F5F4F1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#BFBBB5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerOutlineButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#F28B82"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FDF2F2"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E57373"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EyeToggleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F4F3F1">
        <Grid Margin="32,20,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="User Account Management" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B"/>
                    <TextBlock x:Name="TxtHeaderStats"
                               Text="8 staff accounts · 6 active · 1 invitation pending · 1 deactivated · passwords are never displayed"
                               FontSize="12.5" Foreground="#7A746D" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnViewArchived" Style="{StaticResource OutlineButton}"
                            Height="36" Padding="14,0" Margin="0,0,10,0" VerticalAlignment="Center"
                            Click="BtnViewArchived_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtArchivedButtonLabel" Text="Archived" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnOpenCreateUser"
                            Style="{StaticResource CreateUserButtonStyle}" VerticalAlignment="Center"
                            Click="BtnOpenCreateUser_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create User" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                    Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Search staff" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="TxtSearchStaff" Height="36" Padding="8,0"
                                     FontSize="12.5" VerticalContentAlignment="Center"
                                     TextChanged="FilterInputs_Changed"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="Name, username or user ID..."
                                       Foreground="#9E9892" FontSize="12.5" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbRoleFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Account status" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbStatusFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10"
                    Padding="20,18,20,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Staff directory" FontSize="16" FontWeight="Bold"
                               Foreground="#2B2927" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" x:Name="DgStaff" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0EEEB" Background="White" RowBackground="White"
                              BorderThickness="0" RowHeight="46" SelectionMode="Single" SelectionUnit="FullRow"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="DgStaff_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FAFAFA"/>
                                <Setter Property="Foreground" Value="#5F6368"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FAF8F5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F7E9EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="User ID" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding user_code}" FontWeight="Bold" FontSize="12.5"
                                                   Foreground="{StaticResource UserIdRed}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Full Name" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding full_name}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="#2B2927" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Username" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Username}" FontSize="12.5"
                                                   Foreground="#5F6368" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Role" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding display_role}" FontSize="12.5"
                                                   Foreground="#2B2927" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Account Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadgeBorder" CornerRadius="12" Padding="8,2.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="StatusBadgeText" Text="{Binding status_badge}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding status_badge}" Value="Active">
                                                <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#E6F4EA"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="#CEEAD6"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#137333"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding status_badge}" Value="Inactive">
                                                <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#F1F3F4"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="#E8EAED"/>
                                                <Setter TargetName="StatusBadgeBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#5F6368"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Last Login" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding last_login_formatted}" FontSize="12"
                                                   Foreground="#3C4043" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="12,12,12,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtShowingCount"
                                   Text="Showing 8 of 8 accounts · access restricted to authorized administrators"
                                   FontSize="11.5" Foreground="#7A746D"/>
                        <TextBlock DockPanel.Dock="Right" Text="Page 1 of 1 · All records shown"
                                   FontSize="11.5" Foreground="#7A746D"/>
                    </DockPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1"
                        CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock x:Name="TxtSelTitle" Text="Selected account · Maya Chen"
                                   FontSize="15" FontWeight="Bold" Foreground="#2B2927"/>
                        <TextBlock x:Name="TxtSelSubtitle"
                                   Text="Account status and security verification"
                                   FontSize="11.5" Foreground="#7A746D" Margin="0,2,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Current role" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtSelRole" Text="Rental Staff" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Created" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtSelCreated" Text="14 Oct 2026 · 11:26" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#2B2927" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#F0EEEB" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="Last activity" FontSize="11.5" Foreground="#7A746D" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="TxtSelActivity" Text="Authenticated · 14 Oct, 08:05" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#2B2927" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="BtnEditAccount" Style="{StaticResource OutlineButton}"
                                    Margin="0,0,10,0" Click="BtnEditAccount_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Edit account" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnArchiveAccount" Style="{StaticResource DangerOutlineButton}"
                                    Click="BtnArchiveAccount_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Archive account" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0">
                    <TextBlock Text="Account lifecycle" FontWeight="SemiBold" Foreground="#5F6368" FontSize="12.5"/>
                    <TextBlock FontSize="11.5" Foreground="#7A746D" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"
                               Text="Archiving revokes sign-in access while preserving historical records. Account details, credentials, and roles (System Administrator, Manager, or Rental Staff) can be updated securely by administrators."/>
                </StackPanel>
            </Grid>

        </Grid>

        <Grid x:Name="CreateUserModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="CreateModalBackdrop_MouseDown"/>

            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="500" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Create Staff Account" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                        <TextBlock Text="Set credentials and assign role" FontSize="12" Foreground="#7A746D"/>
                    </StackPanel>

                    <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewFullName" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewUsername" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbNewRole" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Border BorderBrush="#D9D5D0" BorderThickness="1" CornerRadius="4" Background="White" Height="36" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtNewPassword" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                            <TextBox x:Name="TxtNewPasswordReveal" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Visibility="Collapsed"
                                     TextChanged="TxtNewPasswordReveal_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource EyeToggleButtonStyle}"
                                    Click="ToggleNewPassword_Click">
                                <TextBlock x:Name="EyeIconNewPass" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="#7A746D"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Border BorderBrush="#D9D5D0" BorderThickness="1" CornerRadius="4" Background="White" Height="36" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtNewConfirmPassword" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                            <TextBox x:Name="TxtNewConfirmPasswordReveal" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Visibility="Collapsed"
                                     TextChanged="TxtNewConfirmPasswordReveal_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource EyeToggleButtonStyle}"
                                    Click="ToggleNewConfirmPassword_Click">
                                <TextBlock x:Name="EyeIconNewConfirm" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="#7A746D"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="Must be at least 8 characters with uppercase, lowercase, number, and special character."
                               FontSize="11" Foreground="#7A746D" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="100" Click="BtnCloseCreateModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Create Account" Style="{StaticResource PrimaryButton}"
                                Width="130" Click="BtnSaveNewUser_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EditUserModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="EditModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="500" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Edit Staff Account" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                        <TextBlock x:Name="TxtEditSubtitle" Text="Update account profile, credentials and role" FontSize="12" Foreground="#7A746D"/>
                    </StackPanel>

                    <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEditFullName" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEditUsername" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbEditRole" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="NEW PASSWORD (LEAVE BLANK TO KEEP CURRENT)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Border BorderBrush="#D9D5D0" BorderThickness="1" CornerRadius="4" Background="White" Height="36" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtEditPassword" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                            <TextBox x:Name="TxtEditPasswordReveal" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Visibility="Collapsed"
                                     TextChanged="TxtEditPasswordReveal_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource EyeToggleButtonStyle}"
                                    Click="ToggleEditPassword_Click">
                                <TextBlock x:Name="EyeIconEditPass" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="#7A746D"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Border BorderBrush="#D9D5D0" BorderThickness="1" CornerRadius="4" Background="White" Height="36" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtEditConfirmPassword" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                            <TextBox x:Name="TxtEditConfirmPasswordReveal" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Visibility="Collapsed"
                                     TextChanged="TxtEditConfirmPasswordReveal_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource EyeToggleButtonStyle}"
                                    Click="ToggleEditConfirmPassword_Click">
                                <TextBlock x:Name="EyeIconEditConfirm" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="#7A746D"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="Leave blank to keep current password. Must be at least 8 characters with uppercase, lowercase, number, and special character."
                               FontSize="11" Foreground="#7A746D" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="100" Click="BtnCloseEditModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Save Changes" Style="{StaticResource PrimaryButton}"
                                Width="130" Click="BtnSaveEditUser_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ArchivedUsersModal" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ArchivedModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Width="840" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Archived Staff Accounts" FontSize="18" FontWeight="Bold" Foreground="#2B2927"/>
                        <TextBlock Text="Review archived accounts. You can restore an account to the active directory or permanently delete it."
                                   FontSize="12" Foreground="#7A746D"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtNoArchivedUsers" Text="No archived accounts found."
                               Foreground="#7A746D" FontSize="13" HorizontalAlignment="Center"
                               Margin="0,30,0,30" Visibility="Collapsed"/>

                    <Border x:Name="BorderArchivedTable" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8"
                            MaxHeight="340" Margin="0,0,0,16">
                        <DataGrid x:Name="DgArchivedStaff" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0EEEB" Background="White" RowBackground="White"
                                  BorderThickness="0" RowHeight="44" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User ID" Binding="{Binding user_code}" Width="95"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding full_name}" Width="*"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="115"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding display_role}" Width="130"/>
                                <DataGridTemplateColumn Header="Actions" Width="185">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource OutlineButton}" Height="28" Padding="10,0"
                                                        Margin="0,0,8,0" Tag="{Binding UserId}" Click="BtnRestoreUser_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Restore" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DangerOutlineButton}" Height="28" Padding="10,0"
                                                        Tag="{Binding UserId}" Click="BtnPermanentDeleteUser_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Delete" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="TxtArchivedCount" Text="0 archived accounts"
                                   VerticalAlignment="Center" Foreground="#7A746D" FontSize="12"/>
                        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource OutlineButton}"
                                Width="90" Click="BtnCloseArchivedModal_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
