<UserControl x:Class="Presentation.Views.Admin.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="1180"
             FontFamily="Manrope, Segoe UI"
             Background="#F8F8F8">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoRent;component/Presentation/UI/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorder" Color="#E5E0D8"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#2B2927"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#7A7570"/>

            <Style x:Key="PrimaryActionBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandMaroon}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandMaroonHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryActionBtn" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#D0CBC4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F5F3EF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TableSmallExportBtn" TargetType="Button">
                <Setter Property="Background" Value="#F8F6F2"/>
                <Setter Property="Foreground" Value="#70000F"/>
                <Setter Property="BorderBrush" Value="#E2DDD5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EDE8E1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Page Heading -->
                <RowDefinition Height="Auto"/> <!-- 1: Central Export Section -->
                <RowDefinition Height="Auto"/> <!-- 2: Tables Overview -->
            </Grid.RowDefinitions>

            <!-- ROW 0: Page Heading & Subheading -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="System Settings" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Centralized database registers, monthly CSV export engine, and system audit configuration"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- ROW 1: Centralized Monthly CSV Export Engine -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E0D8" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Centralized CSV Export Engine" FontSize="17" FontWeight="Bold" Foreground="#2B2927"/>
                            <TextBlock Text="Select a reporting month and year. All transactional logs (Reservations, Dispatches, Inspections, Maintenance) will be filtered by that month, accompanied by complete snapshots of master registers (Vehicles, Customers, Rates, Users)."
                                       FontSize="12.5" Foreground="#7A7570" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter Controls & Action Buttons -->
                    <Border Background="#FAF8F5" BorderBrush="#ECE7DF" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Month Selector -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Reporting Month" FontSize="11.5" FontWeight="SemiBold" Foreground="#66605A" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbMonth" Width="200" Height="36" SelectedIndex="10"
                                              SelectionChanged="CmbFilter_SelectionChanged">
                                        <ComboBoxItem Content="All Months (Entire History)" Tag="0"/>
                                        <ComboBoxItem Content="January" Tag="1"/>
                                        <ComboBoxItem Content="February" Tag="2"/>
                                        <ComboBoxItem Content="March" Tag="3"/>
                                        <ComboBoxItem Content="April" Tag="4"/>
                                        <ComboBoxItem Content="May" Tag="5"/>
                                        <ComboBoxItem Content="June" Tag="6"/>
                                        <ComboBoxItem Content="July" Tag="7"/>
                                        <ComboBoxItem Content="August" Tag="8"/>
                                        <ComboBoxItem Content="September" Tag="9"/>
                                        <ComboBoxItem Content="October" Tag="10"/>
                                        <ComboBoxItem Content="November" Tag="11"/>
                                        <ComboBoxItem Content="December" Tag="12"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Year Selector -->
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Reporting Year" FontSize="11.5" FontWeight="SemiBold" Foreground="#66605A" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbYear" Width="120" Height="36" SelectedIndex="2"
                                              SelectionChanged="CmbFilter_SelectionChanged">
                                        <ComboBoxItem Content="2024"/>
                                        <ComboBoxItem Content="2025"/>
                                        <ComboBoxItem Content="2026"/>
                                        <ComboBoxItem Content="2027"/>
                                        <ComboBoxItem Content="2028"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Refresh Counts Button -->
                                <Button x:Name="BtnRefreshCounts" Style="{StaticResource SecondaryActionBtn}"
                                        Height="36" Margin="0,20,0,0" Click="BtnRefreshCounts_Click"
                                        ToolTip="Recalculate record counts for the selected month">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh Counts" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Primary Action Buttons Row -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                                <!-- Export All as ZIP -->
                                <Button x:Name="BtnExportAllZip" Style="{StaticResource PrimaryActionBtn}"
                                        Height="40" Padding="20,0" Margin="0,0,12,0"
                                        Click="BtnExportAllZip_Click"
                                        ToolTip="Export all 8 database tables packaged inside a single compressed ZIP archive">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Export All Tables to CSV (ZIP Archive)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Export All to Folder -->
                                <Button x:Name="BtnExportAllFolder" Style="{StaticResource SecondaryActionBtn}"
                                        Height="40" Padding="16,0" Margin="0,0,12,0"
                                        Click="BtnExportAllFolder_Click"
                                        ToolTip="Export each table as an individual CSV file directly into a chosen folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED43;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Export All Tables to Folder..." FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Notification Bar -->
                    <Border x:Name="BorderStatus" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="Ready to export all 8 tables. Select month and click 'Export All Tables to CSV'."
                                       FontSize="12.5" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ROW 2: Tables Overview & Quick Single Export -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E5E0D8" BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Database Tables Register (8 Tables)" FontSize="16" FontWeight="Bold" Foreground="#2B2927"/>
                            <TextBlock Text="Review record counts and filter rules for each table for the selected period, or export an individual table."
                                       FontSize="12.5" Foreground="#7A7570" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Table DataGrid -->
                    <DataGrid x:Name="GridTables" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EFECE6"
                              RowHeight="44" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FAF8F5"/>
                                <Setter Property="Foreground" Value="#66605A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderBrush" Value="#E5E0D8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Table Name -->
                            <DataGridTemplateColumn Header="TABLE NAME" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#70000F" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="13" Foreground="#2B2927" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Classification -->
                            <DataGridTemplateColumn Header="TYPE" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding TableType}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TypeBadgeFg}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Monthly Filter Scope -->
                            <DataGridTextColumn Header="EXPORT FILTER SCOPE" Binding="{Binding FilterScope}" Width="*" ElementStyle="{StaticResource {x:Type TextBlock}}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="#57534E"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Record Count in Selected Month -->
                            <DataGridTemplateColumn Header="RECORDS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecordCountDisplay}" FontWeight="Bold" FontSize="13" Foreground="#1F2937"
                                                   VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Action Button -->
                            <DataGridTemplateColumn Header="ACTION" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Export CSV" Style="{StaticResource TableSmallExportBtn}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0"
                                                Click="BtnExportSingleTable_Click" Tag="{Binding TableKey}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
