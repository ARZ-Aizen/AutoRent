<UserControl x:Class="Presentation.Views.Admin.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120"
             FontFamily="Segoe UI"
             Background="#F8F7F7"
             Loaded="FinancialReportsView_Loaded">

    <UserControl.Resources>

        <!-- CONTENT CARD -->
        <Style x:Key="ReportCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7E2E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- DATE FILTER BUTTON -->
        <Style x:Key="PeriodButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="94"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#302D2E"/>
            <Setter Property="BorderBrush" Value="#D9D4D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ACTION BUTTON -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#302D2E"/>
            <Setter Property="BorderBrush" Value="#D9D4D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- SUMMARY LABEL -->
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#777174"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- SUMMARY VALUE -->
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#76091F"/>
            <Setter Property="Margin" Value="0,9,0,5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- SECTION TITLE -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#252123"/>
        </Style>

        <!-- TABLE STYLE -->
        <Style x:Key="ReportTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF8F8"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinColumnWidth" Value="75"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

    </UserControl.Resources>

    <!-- PAGE CONTAINER -->
    <Grid>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="False"
            PanningMode="VerticalOnly">

            <StackPanel Margin="24,24,24,35">

                <!-- HEADER -->
                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="Financial Reports"
                            FontSize="29"
                            FontWeight="Bold"
                            Foreground="#231F20"/>

                        <TextBlock
                            Text="Track rental revenue, maintenance expenses, and financial performance."
                            FontSize="12"
                            Foreground="#817B7E"
                            TextWrapping="Wrap"
                            Margin="0,5,12,0"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="BtnPrint"
                            Content="Print Report"
                            Style="{StaticResource ActionButton}"
                            Click="BtnPrint_Click"
                            Margin="0,0,9,0"/>

                        <Button
                            x:Name="BtnExport"
                            Content="Export CSV"
                            Style="{StaticResource ActionButton}"
                            Click="BtnExport_Click"/>

                    </StackPanel>

                </Grid>

                <!-- DATE FILTER -->
                <Border
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,0,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal">

                            <Button
                                x:Name="BtnToday"
                                Content="Today"
                                Style="{StaticResource PeriodButton}"
                                Click="BtnToday_Click"/>

                            <Button
                                x:Name="BtnWeek"
                                Content="This Week"
                                Style="{StaticResource PeriodButton}"
                                Click="BtnWeek_Click"/>

                            <Button
                                x:Name="BtnMonth"
                                Content="This Month"
                                Style="{StaticResource PeriodButton}"
                                Click="BtnMonth_Click"/>

                        </StackPanel>

                        <TextBlock
                            x:Name="TxtRange"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#777174"/>

                    </Grid>

                </Border>

                <!-- FINANCIAL SUMMARY -->
                <UniformGrid Columns="4" Margin="0,0,0,18">

                    <!-- REVENUE -->
                    <Border
                        Style="{StaticResource ReportCard}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="Total Revenue"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtRevenue"
                                Text="₱0.00"
                                Style="{StaticResource SummaryValue}"/>

                            <TextBlock
                                Text="Completed rental earnings"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- EXPENSES -->
                    <Border
                        Style="{StaticResource ReportCard}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="Maintenance Expenses"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtExpenses"
                                Text="₱0.00"
                                Style="{StaticResource SummaryValue}"
                                Foreground="#D97706"/>

                            <TextBlock
                                Text="Completed maintenance costs"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- NET -->
                    <Border
                        Style="{StaticResource ReportCard}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="Net Income"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtNet"
                                Text="₱0.00"
                                Style="{StaticResource SummaryValue}"/>

                            <TextBlock
                                Text="Revenue minus maintenance"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- RENTALS -->
                    <Border Style="{StaticResource ReportCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Completed Rentals"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtRentals"
                                Text="0"
                                Style="{StaticResource SummaryValue}"
                                Foreground="#2563EB"/>

                            <TextBlock
                                Text="Completed transactions"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- REVENUE CHART -->
                <Border
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock
                            Text="Revenue Trend"
                            Style="{StaticResource SectionHeading}"/>

                        <TextBlock
                            x:Name="TxtTrendCaption"
                            Text="Revenue performance"
                            FontSize="12"
                            Foreground="#817B7E"
                            Margin="0,5,0,15"/>

                        <!-- CHART CANVAS -->
                        <Canvas
                            x:Name="GraphCanvas"
                            Height="265"
                            Background="Transparent"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            SizeChanged="GraphCanvas_SizeChanged"/>

                        <!-- CHART SUMMARY -->
                        <Grid Margin="0,14,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="TxtTrendTotal"
                                Grid.Column="0"
                                Text="Period total: ₱0.00"
                                FontSize="12"
                                Foreground="#777174"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="TxtPeak"
                                Grid.Column="1"
                                Text="No revenue data"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#76091F"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0"/>

                        </Grid>

                        <TextBlock
                            Text="Based on completed rental transactions."
                            FontSize="11"
                            Foreground="#948D90"
                            Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- REVENUE BY CATEGORY -->
                <Border
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock
                            Text="Revenue by Category"
                            Style="{StaticResource SectionHeading}"/>

                        <TextBlock
                            Text="Completed rental revenue by vehicle category."
                            FontSize="12"
                            Foreground="#817B7E"
                            Margin="0,5,0,14"/>

                        <DataGrid
                            x:Name="DgCategory"
                            Style="{StaticResource ReportTable}"
                            Height="205"
                            HorizontalAlignment="Stretch">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Category"
                                    Binding="{Binding category}"
                                    Width="2*"
                                    MinWidth="150"/>

                                <DataGridTextColumn
                                    Header="Rentals"
                                    Binding="{Binding rentals}"
                                    Width="1*"
                                    MinWidth="90"/>

                                <DataGridTextColumn
                                    Header="Revenue"
                                    Binding="{Binding revenue, StringFormat='₱{0:N2}'}"
                                    Width="1.5*"
                                    MinWidth="135"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

                <!-- MONTHLY SUMMARY -->
                <Border Style="{StaticResource ReportCard}">

                    <StackPanel>

                        <TextBlock
                            Text="Monthly Summary"
                            Style="{StaticResource SectionHeading}"/>

                        <TextBlock
                            Text="Monthly rental revenue, maintenance expenses, and net income."
                            FontSize="12"
                            Foreground="#817B7E"
                            Margin="0,5,0,14"/>

                        <DataGrid
                            x:Name="DgMonth"
                            Style="{StaticResource ReportTable}"
                            Height="225"
                            HorizontalAlignment="Stretch">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Month"
                                    Binding="{Binding month}"
                                    Width="1.3*"
                                    MinWidth="115"/>

                                <DataGridTextColumn
                                    Header="Rentals"
                                    Binding="{Binding rentals}"
                                    Width="0.8*"
                                    MinWidth="85"/>

                                <DataGridTextColumn
                                    Header="Revenue"
                                    Binding="{Binding revenue, StringFormat='₱{0:N2}'}"
                                    Width="1.4*"
                                    MinWidth="125"/>

                                <DataGridTextColumn
                                    Header="Maintenance"
                                    Binding="{Binding expenses, StringFormat='₱{0:N2}'}"
                                    Width="1.4*"
                                    MinWidth="135"/>

                                <DataGridTextColumn
                                    Header="Net Income"
                                    Binding="{Binding net, StringFormat='₱{0:N2}'}"
                                    Width="1.4*"
                                    MinWidth="125"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
