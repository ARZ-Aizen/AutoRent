<UserControl x:Class="Presentation.Views.Admin.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120"
             FontFamily="Segoe UI"
             Background="#F8F7F7"
             Loaded="FinancialReportsView_Loaded">

    <UserControl.Resources>

        <!-- CONTENT CARD -->
        <Style x:Key="ReportCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7E2E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- DATE FILTER BUTTON -->
        <Style x:Key="PeriodButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="94"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#302D2E"/>
            <Setter Property="BorderBrush" Value="#D9D4D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ACTION BUTTON -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#302D2E"/>
            <Setter Property="BorderBrush" Value="#D9D4D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- SUMMARY LABEL -->
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#777174"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- SUMMARY VALUE -->
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#76091F"/>
            <Setter Property="Margin" Value="0,9,0,5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- SECTION TITLE -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#252123"/>
        </Style>

        <!-- MODERN TABLE HEADER STYLES -->
        <Style x:Key="FinancialTableHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F8F7F5"/>
            <Setter Property="Foreground" Value="#5C5750"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="BorderBrush" Value="#E8E5E1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="FinancialTableHeaderRight" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource FinancialTableHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="FinancialTableHeaderCenter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource FinancialTableHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- CUSTOM TABLE CELL STYLE -->
        <Style x:Key="FinancialTableCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F0EEEB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CUSTOM TABLE ROW STYLE -->
        <Style x:Key="FinancialTableRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2B2927"/>
            <Setter Property="BorderBrush" Value="#F0EEEB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFA"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F4F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- PAGE CONTAINER -->
    <Grid>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="False"
            PanningMode="VerticalOnly">

            <StackPanel Margin="24,24,24,35">

                <!-- HEADER -->
                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="Financial Reports"
                            FontSize="29"
                            FontWeight="Bold"
                            Foreground="#231F20"/>

                        <TextBlock
                            Text="Track rental revenue, maintenance expenses, and financial performance."
                            FontSize="12"
                            Foreground="#817B7E"
                            TextWrapping="Wrap"
                            Margin="0,5,12,0"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="BtnPrint"
                            Content="Print Report"
                            Style="{StaticResource ActionButton}"
                            Click="BtnPrint_Click"/>

                    </StackPanel>

                </Grid>

                <!-- DATE FILTER -->
                <Border
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,0,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal">

                            <Button
                                x:Name="BtnToday"
                                Content="Today"
                                Style="{StaticResource PeriodButton}"
                                Click="BtnToday_Click"/>

                            <Button
                                x:Name="BtnWeek"
                                Content="This Week"
                                Style="{StaticResource PeriodButton}"
                                Click="BtnWeek_Click"/>

                            <Button
                                x:Name="BtnMonth"
                                Content="This Month"
                                Style="{StaticResource PeriodButton}"
                                Click="BtnMonth_Click"/>

                        </StackPanel>

                        <TextBlock
                            x:Name="TxtRange"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#777174"/>

                    </Grid>

                </Border>

                <!-- FINANCIAL SUMMARY -->
                <UniformGrid Columns="4" Margin="0,0,0,18">

                    <!-- REVENUE -->
                    <Border
                        Style="{StaticResource ReportCard}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="Total Revenue"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtRevenue"
                                Text="₱0.00"
                                Style="{StaticResource SummaryValue}"/>

                            <TextBlock
                                Text="Completed rental earnings"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- EXPENSES -->
                    <Border
                        Style="{StaticResource ReportCard}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="Maintenance Expenses"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtExpenses"
                                Text="₱0.00"
                                Style="{StaticResource SummaryValue}"
                                Foreground="#D97706"/>

                            <TextBlock
                                Text="Completed maintenance costs"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- NET -->
                    <Border
                        Style="{StaticResource ReportCard}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="Net Income"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtNet"
                                Text="₱0.00"
                                Style="{StaticResource SummaryValue}"/>

                            <TextBlock
                                Text="Revenue minus maintenance"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- RENTALS -->
                    <Border Style="{StaticResource ReportCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Completed Rentals"
                                Style="{StaticResource SummaryLabel}"/>

                            <TextBlock
                                x:Name="TxtRentals"
                                Text="0"
                                Style="{StaticResource SummaryValue}"
                                Foreground="#2563EB"/>

                            <TextBlock
                                Text="Completed transactions"
                                FontSize="11"
                                Foreground="#948D90"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- REVENUE CHART -->
                <Border
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock
                            Text="Revenue Trend"
                            Style="{StaticResource SectionHeading}"/>

                        <TextBlock
                            x:Name="TxtTrendCaption"
                            Text="Revenue performance"
                            FontSize="12"
                            Foreground="#817B7E"
                            Margin="0,5,0,15"/>

                        <!-- CHART CANVAS -->
                        <Canvas
                            x:Name="GraphCanvas"
                            Height="265"
                            Background="Transparent"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            SizeChanged="GraphCanvas_SizeChanged"/>

                        <!-- CHART SUMMARY -->
                        <Grid Margin="0,14,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="TxtTrendTotal"
                                Grid.Column="0"
                                Text="Period total: ₱0.00"
                                FontSize="12"
                                Foreground="#777174"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="TxtPeak"
                                Grid.Column="1"
                                Text="No revenue data"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#76091F"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0"/>

                        </Grid>

                        <TextBlock
                            Text="Based on completed rental transactions."
                            FontSize="11"
                            Foreground="#948D90"
                            Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- REVENUE BY CATEGORY (Improved UI Table without ugly scrollbar) -->
                <Border
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock
                            Text="Revenue by Category"
                            Style="{StaticResource SectionHeading}"/>

                        <TextBlock
                            Text="Completed rental revenue by vehicle category."
                            FontSize="12"
                            Foreground="#817B7E"
                            Margin="0,5,0,14"/>

                        <Border BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <DataGrid
                                x:Name="DgCategory"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserResizeRows="False"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal"
                                HorizontalGridLinesBrush="#F0EEEB"
                                BorderThickness="0"
                                Background="White"
                                AlternationCount="2"
                                ColumnHeaderStyle="{StaticResource FinancialTableHeader}"
                                CellStyle="{StaticResource FinancialTableCell}"
                                RowStyle="{StaticResource FinancialTableRow}"
                                SelectionMode="Single"
                                SelectionUnit="FullRow"
                                MinHeight="90"
                                MaxHeight="280"
                                HorizontalAlignment="Stretch"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Vehicle Category" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#70000F" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding category}" FontWeight="SemiBold" FontSize="12.5" Foreground="#2B2927" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Completed Rentals" HeaderStyle="{StaticResource FinancialTableHeaderCenter}" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F4F3F1" CornerRadius="6" Padding="12,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding rentals}" FontWeight="Bold" FontSize="11.5" Foreground="#2B2927"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Total Revenue" HeaderStyle="{StaticResource FinancialTableHeaderRight}" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding revenue, StringFormat='₱{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="#70000F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>
                        </Border>

                    </StackPanel>

                </Border>

                <!-- MONTHLY SUMMARY (Improved UI Table without empty void) -->
                <Border Style="{StaticResource ReportCard}">

                    <StackPanel>

                        <TextBlock
                            Text="Monthly Summary"
                            Style="{StaticResource SectionHeading}"/>

                        <TextBlock
                            Text="Monthly rental revenue, maintenance expenses, and net income."
                            FontSize="12"
                            Foreground="#817B7E"
                            Margin="0,5,0,14"/>

                        <Border BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <DataGrid
                                x:Name="DgMonth"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserResizeRows="False"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal"
                                HorizontalGridLinesBrush="#F0EEEB"
                                BorderThickness="0"
                                Background="White"
                                AlternationCount="2"
                                ColumnHeaderStyle="{StaticResource FinancialTableHeader}"
                                CellStyle="{StaticResource FinancialTableCell}"
                                RowStyle="{StaticResource FinancialTableRow}"
                                SelectionMode="Single"
                                SelectionUnit="FullRow"
                                MinHeight="85"
                                MaxHeight="280"
                                HorizontalAlignment="Stretch"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Billing Month" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#5C5750" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding month}" FontWeight="SemiBold" FontSize="12.5" Foreground="#2B2927" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Rentals" HeaderStyle="{StaticResource FinancialTableHeaderCenter}" Width="0.9*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F4F3F1" CornerRadius="6" Padding="12,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding rentals}" FontWeight="Bold" FontSize="11.5" Foreground="#2B2927"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Gross Revenue" HeaderStyle="{StaticResource FinancialTableHeaderRight}" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding revenue, StringFormat='₱{0:N2}'}" FontWeight="Bold" FontSize="12.5" Foreground="#70000F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Maintenance Cost" HeaderStyle="{StaticResource FinancialTableHeaderRight}" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding expenses, StringFormat='₱{0:N2}'}" FontWeight="SemiBold" FontSize="12.5" Foreground="#D97706" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Net Income" HeaderStyle="{StaticResource FinancialTableHeaderRight}" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding net, StringFormat='₱{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="#137333" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>
                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>