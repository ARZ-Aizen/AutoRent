<UserControl x:Class="Presentation.Views.Admin.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120"
             Loaded="FinancialReportsView_Loaded"
             FontFamily="Segoe UI"
             Background="#F7F6F5">

    <UserControl.Resources>

        <SolidColorBrush x:Key="Wine" Color="#76091F"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E3E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#393438"/>
            <Setter Property="BorderBrush" Value="#DBD5D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#746D70"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Wine}"/>
            <Setter Property="Margin" Value="0,7,0,3"/>
        </Style>

        <Style x:Key="ReportGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="37"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF8F8"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
        </Style>

    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">



        <StackPanel Margin="24">


            <!-- HEADER -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Financial Reports"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#302B2D"/>

                    <TextBlock Text="Real rental revenue and completed maintenance costs"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="#898184"/>
                </StackPanel>

            </Grid>

            <!-- PERIOD FILTER -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Padding="12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="BtnToday"
                                Content="Today"
                                Style="{StaticResource SmallButton}"
                                Click="BtnToday_Click"
                                Margin="0,0,6,0"/>

                        <Button x:Name="BtnWeek"
                                Content="This Week"
                                Style="{StaticResource SmallButton}"
                                Click="BtnWeek_Click"
                                Margin="0,0,6,0"/>

                        <Button x:Name="BtnMonth"
                                Content="This Month"
                                Style="{StaticResource SmallButton}"
                                Click="BtnMonth_Click"/>

                    </StackPanel>

                    <TextBlock x:Name="TxtRange"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#777075"/>
                </Grid>
            </Border>

            <!-- SUMMARY CARDS -->
            <UniformGrid Columns="4" Margin="0,0,0,12">

                <Border Style="{StaticResource Card}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Rental Revenue"
                                   Style="{StaticResource StatHeading}"/>

                        <TextBlock x:Name="TxtRevenue"
                                   Text="₱0.00"
                                   Style="{StaticResource StatNumber}"/>

                        <TextBlock Text="Completed rentals"
                                   FontSize="11"
                                   Foreground="#999295"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Maintenance Expenses"
                                   Style="{StaticResource StatHeading}"/>

                        <TextBlock x:Name="TxtExpenses"
                                   Text="₱0.00"
                                   Style="{StaticResource StatNumber}"/>

                        <TextBlock Text="Completed maintenance"
                                   FontSize="11"
                                   Foreground="#999295"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Net After Maintenance"
                                   Style="{StaticResource StatHeading}"/>

                        <TextBlock x:Name="TxtNet"
                                   Text="₱0.00"
                                   Style="{StaticResource StatNumber}"/>

                        <TextBlock Text="Revenue minus maintenance"
                                   FontSize="11"
                                   Foreground="#999295"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Completed Rentals"
                                   Style="{StaticResource StatHeading}"/>

                        <TextBlock x:Name="TxtRentals"
                                   Text="0"
                                   Style="{StaticResource StatNumber}"/>

                        <TextBlock Text="Transactions in the period"
                                   FontSize="11"
                                   Foreground="#999295"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- REVENUE GRAPH + CATEGORY TABLE -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- REVENUE CHART -->
                <Border Grid.Column="0"
                        Style="{StaticResource Card}">

                    <StackPanel>

                        <TextBlock Text="Revenue Trend"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#302B2D"/>

                        <TextBlock x:Name="TxtTrendCaption"
                                   FontSize="11"
                                   Foreground="#888184"
                                   Margin="0,4,0,12"/>

                        <Canvas x:Name="GraphCanvas"
                                Background="Transparent"
                                Height="254"
                                SizeChanged="GraphCanvas_SizeChanged"
                                ClipToBounds="True"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtTrendTotal"
                                       FontSize="11"
                                       Foreground="#6B6568"/>

                            <TextBlock x:Name="TxtPeak"
                                       Grid.Column="1"
                                       FontSize="11"
                                       Foreground="#76091F"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- CATEGORY BREAKDOWN -->
                <Border Grid.Column="2"
                        Style="{StaticResource Card}">

                    <StackPanel>

                        <TextBlock Text="Revenue by Category"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#302B2D"/>

                        <TextBlock Text="Completed rentals by vehicle type"
                                   FontSize="11"
                                   Foreground="#888184"
                                   Margin="0,4,0,10"/>


                        <DataGrid x:Name="DgCategory"
          Style="{StaticResource ReportGrid}"
          Height="230"
          HorizontalAlignment="Stretch"
          HorizontalScrollBarVisibility="Auto"
          ColumnWidth="*"
          MinColumnWidth="75">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Category"
                            Binding="{Binding category}"
                            Width="2*"
                            MinWidth="125"/>

                                <DataGridTextColumn Header="Rentals"
                            Binding="{Binding rentals}"
                            Width="1*"
                            MinWidth="75"/>

                                <DataGridTextColumn Header="Revenue"
                            Binding="{Binding revenue, StringFormat='₱{0:N2}'}"
                            Width="1.5*"
                            MinWidth="110"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- MONTHLY SUMMARY -->
            <Border Style="{StaticResource Card}">

                <StackPanel>

                    <TextBlock Text="Monthly Summary"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#302B2D"/>

                    <TextBlock Text="Breakdown for the selected reporting period"
                               FontSize="11"
                               Foreground="#888184"
                               Margin="0,4,0,10"/>

                    <DataGrid x:Name="DgMonth"
                              Style="{StaticResource ReportGrid}"
                              Height="215">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Month"
                                                Binding="{Binding month}"
                                                Width="1.3*"/>

                            <DataGridTextColumn Header="Rentals"
                                                Binding="{Binding rentals}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Revenue"
                                                Binding="{Binding revenue, StringFormat='₱{0:N2}'}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Maintenance"
                                                Binding="{Binding expenses, StringFormat='₱{0:N2}'}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Net"
                                                Binding="{Binding net, StringFormat='₱{0:N2}'}"
                                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
