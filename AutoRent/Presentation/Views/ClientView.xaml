<UserControl x:Class="Presentation.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>

        <!-- ================= SIDEBAR STYLES ================= -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#363030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- ================= PAGE STYLES ================= -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2B2927"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7A746D"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B2927"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B665F"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#70000F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8A0016"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2B2927"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#D9D5D0" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F3F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ================= DATAGRID STYLES ================= -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EFEDEA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2B2927"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F3F1"/>
            <Setter Property="Foreground" Value="#6B665F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F7E9EB"/>
                    <Setter Property="Foreground" Value="#2B2927"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Colors status text automatically -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Available">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </Trigger>
                <Trigger Property="Text" Value="Confirmed">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </Trigger>
                <Trigger Property="Text" Value="Pass">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </Trigger>
                <Trigger Property="Text" Value="Rented">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="Text" Value="Active">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="Text" Value="Reserved">
                    <Setter Property="Foreground" Value="#6A1B9A"/>
                </Trigger>
                <Trigger Property="Text" Value="Scheduled">
                    <Setter Property="Foreground" Value="#E65100"/>
                </Trigger>
                <Trigger Property="Text" Value="Maintenance">
                    <Setter Property="Foreground" Value="#E65100"/>
                </Trigger>
                <Trigger Property="Text" Value="Needs Attention">
                    <Setter Property="Foreground" Value="#C62828"/>
                </Trigger>
                <Trigger Property="Text" Value="Cancelled">
                    <Setter Property="Foreground" Value="#C62828"/>
                </Trigger>
                <Trigger Property="Text" Value="Completed">
                    <Setter Property="Foreground" Value="#7A746D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#2A2A2A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="18,24,18,20">
                        <Border Width="48" Height="48" CornerRadius="10" Background="#7A0010">
                            <TextBlock Text="🚗" FontFamily="Segoe UI Emoji" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AUTORENT" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="CLIENT PORTAL" Foreground="#4A9BFF" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#3A3A3A"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <Button x:Name="BtnHome" Style="{StaticResource SidebarButtonStyle}"
                            Tag="Home (Dashboard)" Click="SidebarOption_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontFamily="Segoe UI Emoji" Width="30"/>
                            <TextBlock Text="Home (Dashboard)"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFleetAvailability" Style="{StaticResource SidebarButtonStyle}"
                            Tag="Fleet Availability" Click="SidebarOption_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚗" FontFamily="Segoe UI Emoji" Width="30"/>
                            <TextBlock Text="Fleet Availability"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCustomerManagement" Style="{StaticResource SidebarButtonStyle}"
                            Tag="Customer Management" Click="SidebarOption_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontFamily="Segoe UI Emoji" Width="30"/>
                            <TextBlock Text="Customer Management"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnReservations" Style="{StaticResource SidebarButtonStyle}"
                            Tag="Reservations" Click="SidebarOption_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontFamily="Segoe UI Emoji" Width="30"/>
                            <TextBlock Text="Reservations"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDailyDispatch" Style="{StaticResource SidebarButtonStyle}"
                            Tag="Daily Dispatch" Click="SidebarOption_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚚" FontFamily="Segoe UI Emoji" Width="30"/>
                            <TextBlock Text="Daily Dispatch"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnVehicleInspection" Style="{StaticResource SidebarButtonStyle}"
                            Tag="Vehicle Inspection" Click="SidebarOption_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" Width="30"/>
                            <TextBlock Text="Vehicle Inspection"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button x:Name="BtnSwitchAdmin" Style="{StaticResource FooterButtonStyle}"
                            Click="BtnSwitchAdmin_Click" Margin="8,0,8,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" Width="30" FontSize="16"/>
                            <TextBlock Text="Switch to Admin Console"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="#3A3A3A" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="20,0,20,10">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#3F3F3F">
                            <TextBlock Text="👤" FontFamily="Segoe UI Emoji" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserName" Text="admin" Foreground="White"
                                       FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="TxtUserRole" Text="ADMIN" Foreground="#9A9A9A" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnSettings" Style="{StaticResource FooterButtonStyle}"
                            Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="30" FontSize="16"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSignOut" Style="{StaticResource FooterButtonStyle}"
                            Foreground="#FF5C6C" FontWeight="SemiBold" Click="BtnSignOut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻" Width="30" FontSize="16"/>
                            <TextBlock Text="Sign Out"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= CONTENT PAGES ================= -->
        <Border Grid.Column="1" Background="#F4F3F1">
            <Grid>

                <!-- ============ 1. HOME (DASHBOARD) ============ -->
                <Grid x:Name="PageHome" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="TxtHomeDate" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Total Vehicles" FontSize="12" Foreground="#7A746D"/>
                                <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="30" FontWeight="Bold" Foreground="#2B2927"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Available Now" FontSize="12" Foreground="#7A746D"/>
                                <TextBlock x:Name="TxtStatAvailable" Text="0" FontSize="30" FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Active Reservations" FontSize="12" Foreground="#7A746D"/>
                                <TextBlock x:Name="TxtStatReservations" Text="0" FontSize="30" FontWeight="Bold" Foreground="#1565C0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Pending Dispatches" FontSize="12" Foreground="#7A746D"/>
                                <TextBlock x:Name="TxtStatDispatch" Text="0" FontSize="30" FontWeight="Bold" Foreground="#E65100"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Grid.Row="2" Text="Recent Reservations" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgRecent" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding Vehicle}"/>
                            <DataGridTextColumn Header="Pickup" Binding="{Binding PickupDate, StringFormat='MMM dd, yyyy'}"/>
                            <DataGridTextColumn Header="Return" Binding="{Binding ReturnDate, StringFormat='MMM dd, yyyy'}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============ 2. FLEET AVAILABILITY ============ -->
                <Grid x:Name="PageFleet" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Fleet Availability" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="See which vehicles are available, reserved, rented, or in maintenance." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtFleetSearch" Width="260"
                                     ToolTip="Search by plate, model or category"
                                     TextChanged="TxtFleetSearch_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbFleetStatus" Width="160" SelectedIndex="0"
                                      SelectionChanged="CmbFleetStatus_SelectionChanged">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Available"/>
                                <ComboBoxItem Content="Reserved"/>
                                <ComboBoxItem Content="Rented"/>
                                <ComboBoxItem Content="Maintenance"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="TxtFleetCount" VerticalAlignment="Bottom" Margin="16,0,0,8"
                                   Foreground="#7A746D" FontSize="12"/>
                    </StackPanel>

                    <DataGrid x:Name="DgFleet" Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plate No." Binding="{Binding Plate}"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding Model}" Width="1.5*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyRate, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============ 3. CUSTOMER MANAGEMENT ============ -->
                <Grid x:Name="PageCustomers" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Customer Management" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Register new customers and manage existing records." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCustName" Width="190"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCustPhone" Width="140"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCustEmail" Width="200"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="LICENSE NO." Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCustLicense" Width="140"/>
                            </StackPanel>
                            <Button Content="Add Customer" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" Click="BtnAddCustomer_Click"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCustSearch" Width="260"
                                     ToolTip="Search by name, phone, email or license"
                                     TextChanged="TxtCustSearch_TextChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Delete Selected" Style="{StaticResource OutlineButton}"
                                VerticalAlignment="Bottom" Click="BtnDeleteCustomer_Click"/>
                    </Grid>

                    <DataGrid x:Name="DgCustomers" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                            <DataGridTextColumn Header="License No." Binding="{Binding License}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============ 4. RESERVATIONS ============ -->
                <Grid x:Name="PageReservations" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Reservations" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Create new bookings and manage existing ones." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbResCustomer" Width="190" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="AVAILABLE VEHICLE" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbResVehicle" Width="230" DisplayMemberPath="Display"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="PICKUP DATE" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DpPickup" Width="130"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="RETURN DATE" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DpReturn" Width="130"/>
                            </StackPanel>
                            <Button Content="Create" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" Click="BtnCreateReservation_Click"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="All Reservations" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel Selected" Style="{StaticResource OutlineButton}"
                                    Margin="0,0,8,0" Click="BtnCancelReservation_Click"/>
                            <Button Content="Mark Completed" Style="{StaticResource PrimaryButton}"
                                    Click="BtnCompleteReservation_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="DgReservations" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.7*"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="1.2*"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding Vehicle}" Width="1.6*"/>
                            <DataGridTextColumn Header="Pickup" Binding="{Binding PickupDate, StringFormat='MMM dd, yyyy'}"/>
                            <DataGridTextColumn Header="Return" Binding="{Binding ReturnDate, StringFormat='MMM dd, yyyy'}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============ 5. DAILY DISPATCH ============ -->
                <Grid x:Name="PageDispatch" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Daily Dispatch" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="TxtDispatchSummary" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <TextBlock Text="SHOW" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbDispatchType" Width="160" SelectedIndex="0"
                                      SelectionChanged="CmbDispatchType_SelectionChanged">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Pickup"/>
                                <ComboBoxItem Content="Return"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Mark Completed" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom" Click="BtnMarkDispatchDone_Click"/>
                    </Grid>

                    <DataGrid x:Name="DgDispatch" Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="0.8*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding DispatchType}" Width="0.8*"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="1.2*"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding Vehicle}" Width="1.6*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============ 6. VEHICLE INSPECTION ============ -->
                <Grid x:Name="PageInspection" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
                        <TextBlock Text="Vehicle Inspection" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Record a vehicle check. A failed check marks the vehicle as Maintenance." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="VEHICLE" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbInspVehicle" DisplayMemberPath="Display" Margin="0,0,0,12"/>

                                <TextBlock Text="INSPECTOR" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtInspector" Margin="0,0,0,12"/>

                                <TextBlock Text="CHECKLIST (tick = OK)" Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="ChkExterior" Content="Exterior (body, paint, glass)"/>
                                <CheckBox x:Name="ChkTires" Content="Tires and wheels"/>
                                <CheckBox x:Name="ChkLights" Content="Lights and signals"/>
                                <CheckBox x:Name="ChkInterior" Content="Interior and seats"/>
                                <CheckBox x:Name="ChkBrakes" Content="Brakes"/>
                                <CheckBox x:Name="ChkFluids" Content="Engine oil and fluids"/>

                                <TextBlock Text="FUEL LEVEL" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                <ComboBox x:Name="CmbFuel" SelectedIndex="0" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Full"/>
                                    <ComboBoxItem Content="3/4"/>
                                    <ComboBoxItem Content="1/2"/>
                                    <ComboBoxItem Content="1/4"/>
                                    <ComboBoxItem Content="Empty"/>
                                </ComboBox>

                                <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtInspNotes" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" Padding="8,6" Margin="0,0,0,16"/>

                                <Button Content="Save Inspection" Style="{StaticResource PrimaryButton}"
                                        Click="BtnSaveInspection_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Inspection History" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DgInspections" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding InspectedOn, StringFormat='MMM dd, h:mm tt'}"/>
                                <DataGridTextColumn Header="Vehicle" Binding="{Binding Vehicle}" Width="1.5*"/>
                                <DataGridTextColumn Header="Inspector" Binding="{Binding Inspector}"/>
                                <DataGridTextColumn Header="Fuel" Binding="{Binding Fuel}" Width="0.6*"/>
                                <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="1.4*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" ElementStyle="{StaticResource StatusText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>