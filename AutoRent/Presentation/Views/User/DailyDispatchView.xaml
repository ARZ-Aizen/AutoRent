<UserControl x:Class="Presentation.Views.User.DailyDispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>

            <!-- Custom Header Style for DataGrid -->
            <Style x:Key="ModernTableHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F8F7F5"/>
                <Setter Property="Foreground" Value="#5C5750"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style x:Key="ModernTableHeaderCenter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ModernTableHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Custom Cell Style -->
            <Style x:Key="ModernTableCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                        <Setter Property="Foreground" Value="#70000F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Row Style -->
            <Style x:Key="ModernTableRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FCFBFA"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F4F1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Pagination button base -->
            <Style x:Key="PageBtn" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White"
                                    BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F6F5F3"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D0CBC5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Complete Handoff Action Button -->
            <Style x:Key="RowHandoffBtn" TargetType="Button">
                <Setter Property="Background" Value="#F1F8F3"/>
                <Setter Property="Foreground" Value="#137333"/>
                <Setter Property="BorderBrush" Value="#CEEAD6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6F4EA"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#A8DAB5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Page Heading & Actions -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Daily Dispatch Operations" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="TxtDispatchSubtitle"
                               Text="Live schedule of vehicle departures and returns · Complete handoffs and track branch dispatches"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">


                    <Button x:Name="BtnRefresh"
                            Style="{StaticResource OutlineButton}"
                            Height="38"
                            Padding="16,0"
                            Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Board" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- ROW 1: 4 Metric Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Dispatches -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TODAY'S SCHEDULE" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B" Margin="0,4,0,2"/>
                            <TextBlock Text="Total scheduled today" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F4F3F1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2B2927"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Pickups Scheduled -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PICKUPS SCHEDULED" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatPickups" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,2"/>
                            <TextBlock Text="Vehicle departures" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E3EEF9" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#1565C0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Returns Scheduled -->
                <Border Grid.Column="4" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RETURNS SCHEDULED" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatReturns" Text="0" FontSize="26" FontWeight="Bold" Foreground="#137333" Margin="0,4,0,2"/>
                            <TextBlock Text="Vehicle arrivals" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E6F4EA" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE729;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#137333"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Completed Handoffs -->
                <Border Grid.Column="6" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="COMPLETED HANDOFFS" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatCompleted" Text="0" FontSize="26" FontWeight="Bold" Foreground="#5F5B56" Margin="0,4,0,2"/>
                            <TextBlock Text="Finished today" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F3F1ED" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#5F5B56"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: Filters Bar -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Padding="16,14" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Search Dispatches" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="TxtSearchDispatch" Height="36" Padding="32,0,10,0"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     TextChanged="TxtSearchDispatch_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#9E9892"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="TxtSearchWatermark" Text="Search customer, plate, vehicle or branch..."
                                       Foreground="#A39D96" FontSize="12.5" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="32,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Type Filter -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dispatch Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbDispatchType" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbStatusFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                    </StackPanel>

                    <!-- Reset Button -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <Button x:Name="BtnResetFilters" Content="Reset" Style="{StaticResource OutlineButton}"
                                Height="36" Padding="16,0" Click="BtnResetFilters_Click"
                                ToolTip="Reset search and filters"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 3: Dispatch Table Card -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                    Padding="0" ClipToBounds="True" MinHeight="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                </Border.Effect>

                <Grid>
                    <DataGrid x:Name="DgDispatch"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0EEEB"
                              BorderThickness="0"
                              Background="White"
                              AlternationCount="2"
                              ColumnHeaderStyle="{StaticResource ModernTableHeader}"
                              CellStyle="{StaticResource ModernTableCell}"
                              RowStyle="{StaticResource ModernTableRow}"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <!-- Time -->
                            <DataGridTemplateColumn Header="SCHEDULED TIME" Width="150"
                                                    HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F4F3F1" BorderBrush="#E0DDD9" BorderThickness="1"
                                                CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Time}" FontWeight="Bold" FontSize="12" Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Type (Pickup vs Return) -->
                            <DataGridTemplateColumn Header="TYPE" Width="130"
                                                    HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBgColor}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DispatchType}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding TypeFgColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Customer -->
                            <DataGridTemplateColumn Header="CUSTOMER" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{Binding CustomerAvatarBg}">
                                                <TextBlock Text="{Binding CustomerInitials}" Foreground="{Binding CustomerAvatarFg}"
                                                           FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Customer}" FontWeight="Bold" FontSize="13" Foreground="#2B2927"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Vehicle -->
                            <DataGridTemplateColumn Header="VEHICLE" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F4F3F1" BorderBrush="#E0DDD9" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Plate}" FontWeight="Bold" FontSize="11" Foreground="#5F5B56"/>
                                            </Border>
                                            <TextBlock Text="{Binding Vehicle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2B2927" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Location / Branch -->
                            <DataGridTemplateColumn Header="BRANCH" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#8C857B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#5F5B56" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="STATUS" Width="140"
                                                    HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding StatusBgColor}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#E2DFD9"/>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{Binding StatusDotColor}"/>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusUpper}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding StatusFgColor}"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="ACTION" Width="150"
                                                    HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowHandoffBtn}"
                                                Click="BtnCompleteDispatch_Click"
                                                Tag="{Binding}"
                                                IsEnabled="{Binding IsPending}"
                                                HorizontalAlignment="Center"
                                                ToolTip="Mark dispatch handoff completed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Complete" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <Border x:Name="BorderEmptyState" Background="White" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#F7F5F3" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A59F98"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No dispatch events found" FontSize="15" FontWeight="Bold" Foreground="#2B2927" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Try adjusting your filter or search terms." FontSize="12.5" Foreground="#7A746D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ROW 4: Pagination Card -->
            <Border Grid.Row="4" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="14"
                    Padding="24,12" Margin="0,16,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtPaging" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#A59F98"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPrev" Style="{StaticResource PageBtn}" Click="BtnPrev_Click" Margin="0,0,8,0">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D"/>
                        </Button>

                        <ItemsControl x:Name="IcPages">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Button x:Name="BtnNext" Style="{StaticResource PageBtn}" Click="BtnNext_Click">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>