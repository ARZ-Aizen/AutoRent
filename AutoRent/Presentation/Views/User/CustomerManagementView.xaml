<UserControl x:Class="Presentation.Views.User.CustomerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern table header -->
            <Style x:Key="ModernTableHeader"
                   TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F5F3F1"/>
                <Setter Property="Foreground" Value="#393633"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,14"/>
                <Setter Property="BorderBrush" Value="#E7E2DD"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Table cells -->
            <Style x:Key="ModernTableCell"
                   TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#F0EDE9"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F5E7E9"/>
                        <Setter Property="Foreground" Value="#780018"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Table rows -->
            <Style x:Key="ModernTableRow"
                   TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#393633"/>
                <Setter Property="BorderBrush" Value="#F0EDE9"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FCFBFA"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F2EF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F5E7E9"/>
                        <Setter Property="Foreground" Value="#780018"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Customer Management"
                       Style="{StaticResource PageTitle}"/>
            <TextBlock
                Text="Register new customers and manage existing records."
                Style="{StaticResource PageSubtitle}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Add customer form -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Text="Full name"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtCustName"
                             Tag="e.g. Juan Dela Cruz"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                    <TextBlock Text="Phone"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtCustPhone"
                             Tag="09XX XXX XXXX"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">
                    <TextBlock Text="Email"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtCustEmail"
                             Tag="name@example.com"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0">
                    <TextBlock Text="License no."
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtCustLicense"
                             Tag="e.g. N01-23-456789"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Add Customer"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Click="BtnAddCustomer_Click"/>
            </Grid>
        </Border>

        <!-- Search and delete controls -->
        <Grid Grid.Row="2"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Left">
                <TextBlock Text="Search"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtCustSearch"
                         Tag="Search name, phone, email or license"
                         Width="300"
                         ToolTip="Search by name, phone, email or license"
                         TextChanged="TxtCustSearch_TextChanged"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Delete selected"
                    Style="{StaticResource OutlineButton}"
                    VerticalAlignment="Bottom"
                    Click="BtnDeleteCustomer_Click"/>
        </Grid>

        <!-- Outlined customer table -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E4DFDA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0"
                ClipToBounds="True">

            <DataGrid x:Name="DgCustomers"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0EDE9"
                      BorderThickness="0"
                      Background="White"
                      AlternationCount="2"
                      ColumnHeaderStyle="{StaticResource ModernTableHeader}"
                      CellStyle="{StaticResource ModernTableCell}"
                      RowStyle="{StaticResource ModernTableRow}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        Width="1.1*"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="License No."
                                        Binding="{Binding License}"
                                        Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
