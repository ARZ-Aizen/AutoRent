<UserControl x:Class="Presentation.Views.User.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>

            <!-- Action buttons in header -->
            <Style x:Key="PrimaryActionBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandMaroon}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandMaroonHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom Header Style for DataGrid -->
            <Style x:Key="ModernTableHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F8F7F5"/>
                <Setter Property="Foreground" Value="#5C5750"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style x:Key="ModernTableHeaderCenter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ModernTableHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Custom Cell Style -->
            <Style x:Key="ModernTableCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                        <Setter Property="Foreground" Value="#70000F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Row Style -->
            <Style x:Key="ModernTableRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FCFBFA"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F4F1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Pagination button base -->
            <Style x:Key="PageBtn" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White"
                                    BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F6F5F3"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D0CBC5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Action Complete Button -->
            <Style x:Key="RowCompleteBtn" TargetType="Button">
                <Setter Property="Background" Value="#F1F8F3"/>
                <Setter Property="Foreground" Value="#137333"/>
                <Setter Property="BorderBrush" Value="#CEEAD6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6F4EA"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#A8DAB5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Action Cancel Button -->
            <Style x:Key="RowCancelBtn" TargetType="Button">
                <Setter Property="Background" Value="#FBF8F8"/>
                <Setter Property="Foreground" Value="#9B2C3B"/>
                <Setter Property="BorderBrush" Value="#EBD5D7"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FDF2F2"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E57373"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Page Heading & Actions -->
                <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Reservation Management" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Book vehicles for registered customers, track active rentals, and manage return schedules"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">


                        <Button x:Name="BtnOpenNewReservation"
                                Style="{StaticResource PrimaryActionBtn}"
                                Click="BtnOpenNewReservation_Click"
                                ToolTip="Create a new vehicle reservation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Reservation" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- ROW 1: 4 Metric Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Bookings -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL BOOKINGS" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B" Margin="0,4,0,2"/>
                                <TextBlock Text="All customer bookings" FontSize="11.5" Foreground="#7A746D"/>
                            </StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#F4F3F1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2B2927"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Active Rentals -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE RENTALS" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtStatActive" Text="0" FontSize="26" FontWeight="Bold" Foreground="#137333" Margin="0,4,0,2"/>
                                <TextBlock Text="On road with customer" FontSize="11.5" Foreground="#7A746D"/>
                            </StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#E6F4EA" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#137333"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Confirmed Upcoming -->
                    <Border Grid.Column="4" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CONFIRMED" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtStatConfirmed" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,2"/>
                                <TextBlock Text="Awaiting pickup dispatch" FontSize="11.5" Foreground="#7A746D"/>
                            </StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#E3EEF9" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#1565C0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Completed -->
                    <Border Grid.Column="6" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="COMPLETED" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtStatCompleted" Text="0" FontSize="26" FontWeight="Bold" Foreground="#5F5B56" Margin="0,4,0,2"/>
                                <TextBlock Text="Returned &amp; settled" FontSize="11.5" Foreground="#7A746D"/>
                            </StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#F3F1ED" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#5F5B56"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 2: Filters Bar -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                        Padding="16,14" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Search Reservations" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <TextBox x:Name="TxtSearchRes" Height="36" Padding="32,0,10,0"
                                         VerticalContentAlignment="Center" FontSize="13"
                                         TextChanged="TxtSearchRes_TextChanged"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#9E9892"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtSearchWatermark" Text="Search ID, customer, plate or vehicle..."
                                           Foreground="#A39D96" FontSize="12.5" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="32,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Status Filter -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbStatusFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Sort By -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Sort By" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbSort" Height="36" SelectionChanged="FilterInputs_Changed"/>
                        </StackPanel>

                        <!-- Reset Button -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                            <Button x:Name="BtnResetFilters" Content="Reset" Style="{StaticResource OutlineButton}"
                                    Height="36" Padding="16,0" Click="BtnResetFilters_Click"
                                    ToolTip="Reset search and filters"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 3: Reservations Table Card -->
                <Border Grid.Row="3" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                        Padding="0" ClipToBounds="True" MinHeight="380">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>

                    <Grid>
                        <DataGrid x:Name="DgReservations"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0EEEB"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternationCount="2"
                                  ColumnHeaderStyle="{StaticResource ModernTableHeader}"
                                  CellStyle="{StaticResource ModernTableCell}"
                                  RowStyle="{StaticResource ModernTableRow}"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <!-- Booking ID -->
                                <DataGridTemplateColumn Header="BOOKING ID" Width="120"
                                                        HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7E9EB" BorderBrush="#E7C0C7" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11.5" Foreground="#70000F"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Customer -->
                                <DataGridTemplateColumn Header="CUSTOMER" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{Binding CustomerAvatarBg}">
                                                    <TextBlock Text="{Binding CustomerInitials}" Foreground="{Binding CustomerAvatarFg}"
                                                               FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Customer}" FontWeight="Bold" FontSize="13" Foreground="#2B2927"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Vehicle -->
                                <DataGridTemplateColumn Header="VEHICLE" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#F4F3F1" BorderBrush="#E0DDD9" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Plate}" FontWeight="Bold" FontSize="11" Foreground="#5F5B56"/>
                                                </Border>
                                                <TextBlock Text="{Binding Vehicle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dates -->
                                <DataGridTemplateColumn Header="RENTAL PERIOD" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DateRangeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#2B2927"/>
                                                <TextBlock Text="{Binding DurationDisplay}" FontSize="11" Foreground="#8C857B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total -->
                                <DataGridTemplateColumn Header="TOTAL" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalDisplay}" FontSize="13" FontWeight="Bold" Foreground="#70000F" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status -->
                                <DataGridTemplateColumn Header="STATUS" Width="140"
                                                        HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding StatusBgColor}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="#E2DFD9"/>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{Binding StatusDotColor}"/>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusUpper}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{Binding StatusFgColor}"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="ACTIONS" Width="180"
                                                        HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowCompleteBtn}"
                                                        Click="BtnCompleteRow_Click"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanBeManaged}"
                                                        Margin="0,0,6,0"
                                                        ToolTip="Mark rental trip completed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Complete" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource RowCancelBtn}"
                                                        Click="BtnCancelRow_Click"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanBeManaged}"
                                                        ToolTip="Cancel booking">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Cancel" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State message -->
                        <Border x:Name="BorderEmptyState" Background="White" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#F7F5F3" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A59F98"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No reservations found" FontSize="15" FontWeight="Bold" Foreground="#2B2927" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Try adjusting your search query or status filter." FontSize="12.5" Foreground="#7A746D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 4: Pagination Card -->
                <Border Grid.Row="4" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="14"
                        Padding="24,12" Margin="0,16,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtPaging" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#A59F98"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPrev" Style="{StaticResource PageBtn}" Click="BtnPrev_Click" Margin="0,0,8,0">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D"/>
                            </Button>

                            <ItemsControl x:Name="IcPages">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Button x:Name="BtnNext" Style="{StaticResource PageBtn}" Click="BtnNext_Click">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- CREATE RESERVATION MODAL OVERLAY -->
        <Grid x:Name="ReservationModalOverlay" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#66000000" MouseDown="ModalBackdrop_MouseDown"/>
            <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="16"
                    Width="520" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#F7E9EB" Margin="0,0,14,0">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#70000F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Create New Reservation" FontSize="18" FontWeight="Bold" Foreground="#1F1D1B"/>
                            <TextBlock Text="Book an available fleet vehicle for a customer" FontSize="12.5" Foreground="#7A746D" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="BtnCloseModal_Click" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8C857B"/>
                        </Button>
                    </Grid>

                    <!-- Error Banner -->
                    <Border x:Name="BorderModalError" Background="#FDF2F2" BorderBrush="#F5C2C7" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#C62828" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtModalError" Text="Validation message" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Customer Picker -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Select Customer" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbModalCustomer" Height="38" SelectionChanged="CmbModalCustomer_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="False" MinWidth="380">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#2B2927"/>
                                            <TextBlock Text="{Binding CustomerIdDisplay}" FontSize="11" Foreground="#8C857B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="{Binding LicenseBadgeBg}"
                                                BorderBrush="{Binding LicenseBadgeBorder}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LicenseBadgeIcon}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9.5" Foreground="{Binding LicenseBadgeFg}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LicenseBadgeText}" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{Binding LicenseBadgeFg}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- License Warning for Selected Customer -->
                        <Border x:Name="BorderCustomerLicenseNotice" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#B91C1C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCustomerLicenseNotice"
                                           Text="This customer does not have a verified driver's license on file and cannot rent. Please add a valid driver's license in Customer Management before proceeding."
                                           FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Available Vehicle Picker -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Select Available Vehicle" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbModalVehicle" Height="38" DisplayMemberPath="Display"
                                  SelectionChanged="ModalInputs_Changed"/>
                    </StackPanel>

                    <!-- Dates side-by-side -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pickup Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DpModalPickup" Height="38" SelectedDateChanged="ModalDates_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Return Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DpModalReturn" Height="38" SelectedDateChanged="ModalDates_Changed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Rate & Cost Summary Box -->
                    <Border Background="#F9F8F6" BorderBrush="#EAE6E1" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DAILY RATE" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtModalDailyRate" Text="₱0.00 / day" FontSize="14" FontWeight="Bold" Foreground="#1F1D1B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DURATION" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtModalDuration" Text="1 day" FontSize="14" FontWeight="Bold" Foreground="#1F1D1B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ESTIMATED TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                                <TextBlock x:Name="TxtModalTotal" Text="₱0.00" FontSize="16" FontWeight="Bold" Foreground="#70000F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Width="110" Height="38" Click="BtnCloseModal_Click"/>
                        <Button DockPanel.Dock="Right" Content="Confirm Booking" Style="{StaticResource PrimaryActionBtn}"
                                Width="160" Height="38" Click="BtnSaveReservation_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
