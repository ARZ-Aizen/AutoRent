<UserControl x:Class="Presentation.Views.User.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main responsive page -->
    <Grid Margin="30,24,30,24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Reservations"
                       Style="{StaticResource PageTitle}"
                       TextWrapping="Wrap"/>

            <TextBlock
                Text="Create new bookings and manage existing ones."
                Style="{StaticResource PageSubtitle}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Create reservation form -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,20"
                HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">

                    <TextBlock Text="Customer"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="CmbResCustomer"
                              Tag="Select customer"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="Available vehicle"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="CmbResVehicle"
                              Tag="Select vehicle"
                              DisplayMemberPath="Display"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">

                    <TextBlock Text="Pickup date"
                               Style="{StaticResource FieldLabel}"/>

                    <DatePicker x:Name="DpPickup"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0">

                    <TextBlock Text="Return date"
                               Style="{StaticResource FieldLabel}"/>

                    <DatePicker x:Name="DpReturn"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Create Reservation"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Click="BtnCreateReservation_Click"/>
            </Grid>
        </Border>

        <!-- Reservation actions -->
        <Grid Grid.Row="2"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="All reservations"
                       Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Cancel selected"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"
                        Click="BtnCancelReservation_Click"/>

                <Button Content="Mark completed"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnCompleteReservation_Click"/>
            </StackPanel>
        </Grid>

        <!-- Reservations table fills remaining space -->
        <Border Grid.Row="3"
                Style="{StaticResource GridCard}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MinWidth="0">

            <DataGrid x:Name="DgReservations"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MinWidth="0">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding Id}"
                        Width="0.7*"/>

                    <DataGridTextColumn
                        Header="Customer"
                        Binding="{Binding Customer}"
                        Width="1.2*"/>

                    <DataGridTextColumn
                        Header="Vehicle"
                        Binding="{Binding Vehicle}"
                        Width="1.6*"/>

                    <DataGridTextColumn
                        Header="Pickup"
                        Binding="{Binding PickupDate, StringFormat='MMM dd, yyyy'}"
                        Width="1.2*"/>

                    <DataGridTextColumn
                        Header="Return"
                        Binding="{Binding ReturnDate, StringFormat='MMM dd, yyyy'}"
                        Width="1.2*"/>

                    <DataGridTextColumn
                        Header="Total"
                        Binding="{Binding Total, StringFormat=N2}"
                        Width="1*"/>

                    <DataGridTemplateColumn
                        Header="Status"
                        SortMemberPath="Status"
                        Width="1*">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <ContentControl
                                    Content="{Binding Status}"
                                    ContentTemplate="{StaticResource StatusPill}"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
