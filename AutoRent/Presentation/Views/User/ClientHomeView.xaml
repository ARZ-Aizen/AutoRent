<UserControl x:Class="Presentation.Views.User.ClientHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern table header -->
            <Style x:Key="ModernTableHeader"
                   TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F5F3F1"/>
                <Setter Property="Foreground" Value="#393633"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,14"/>
                <Setter Property="BorderBrush" Value="#E7E2DD"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Table cells -->
            <Style x:Key="ModernTableCell"
                   TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#F0EDE9"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F5E7E9"/>
                        <Setter Property="Foreground" Value="#780018"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Table rows -->
            <Style x:Key="ModernTableRow"
                   TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#393633"/>
                <Setter Property="BorderBrush" Value="#F0EDE9"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FCFBFA"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F2EF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F5E7E9"/>
                        <Setter Property="Foreground" Value="#780018"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dashboard heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Dashboard"
                       Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="TxtHomeDate"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Statistics cards -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,28">

            <Border Style="{StaticResource StatCard}"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Total vehicles"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtStatTotal"
                                   Text="0"
                                   Style="{StaticResource StatValue}"
                                   Foreground="#2B2927"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource IconChip}"
                            Background="#EEEBE7">
                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#2B2927"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCard}"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Available now"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtStatAvailable"
                                   Text="0"
                                   Style="{StaticResource StatValue}"
                                   Foreground="#2E7D32"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource IconChip}"
                            Background="#E6F2E7">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCard}"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Active reservations"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtStatReservations"
                                   Text="0"
                                   Style="{StaticResource StatValue}"
                                   Foreground="#1565C0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource IconChip}"
                            Background="#E3EEF9">
                        <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#1565C0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pending dispatches"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtStatDispatch"
                                   Text="0"
                                   Style="{StaticResource StatValue}"
                                   Foreground="#E65100"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource IconChip}"
                            Background="#FDEBDD">
                        <TextBlock Text="&#xE81D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#E65100"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Recent reservations heading -->
        <TextBlock Grid.Row="2"
                   Text="Recent reservations"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,12"/>

        <!-- Outlined reservations table -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E4DFDA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0"
                ClipToBounds="True">

            <DataGrid x:Name="DgRecent"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0EDE9"
                      BorderThickness="0"
                      Background="White"
                      AlternationCount="2"
                      ColumnHeaderStyle="{StaticResource ModernTableHeader}"
                      CellStyle="{StaticResource ModernTableCell}"
                      RowStyle="{StaticResource ModernTableRow}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="0.7*"/>

                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding Customer}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Vehicle"
                                        Binding="{Binding Vehicle}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Pickup"
                                        Binding="{Binding PickupDate, StringFormat='MMM dd, yyyy'}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Return"
                                        Binding="{Binding ReturnDate, StringFormat='MMM dd, yyyy'}"
                                        Width="1.2*"/>

                    <DataGridTemplateColumn Header="Status"
                                            SortMemberPath="Status"
                                            Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Status}"
                                                ContentTemplate="{StaticResource StatusPill}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
