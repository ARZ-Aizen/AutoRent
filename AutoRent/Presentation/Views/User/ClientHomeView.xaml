<UserControl x:Class="Presentation.Views.User.ClientHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>

            <!-- Modern Table Header Style -->
            <Style x:Key="ModernTableHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F8F7F5"/>
                <Setter Property="Foreground" Value="#5C5750"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,12"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style x:Key="ModernTableHeaderCenter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ModernTableHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Modern Table Cell Style -->
                        <Style x:Key="ModernTableCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                        <Setter Property="Foreground" Value="#70000F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern Table Row Style -->
            <Style x:Key="ModernTableRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="50"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FCFBFA"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F4F1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,22" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Operations Dashboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="TxtHomeDate" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh"
                            Style="{StaticResource OutlineButton}"
                            Height="38"
                            Padding="16,0"
                            Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Data" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- ROW 1: Booking activity (fleet status lives below in Fleet Readiness) -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="16,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL BOOKINGS" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtBookingsTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B" Margin="0,5,0,2"/>
                            <TextBlock Text="All reservations" FontSize="11" Foreground="#7A746D" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Width="35" Height="35" CornerRadius="9" Background="#F4F3F1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#1F1D1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="16,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONFIRMED" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtBookingsConfirmed" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1565C0" Margin="0,5,0,2"/>
                            <TextBlock Text="Awaiting pickup" FontSize="11" Foreground="#7A746D" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Width="35" Height="35" CornerRadius="9" Background="#E3EEF9" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="16,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE TRIPS" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtBookingsActive" Text="0" FontSize="26" FontWeight="Bold" Foreground="#137333" Margin="0,5,0,2"/>
                            <TextBlock Text="Vehicles on hire" FontSize="11" Foreground="#7A746D" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Width="35" Height="35" CornerRadius="9" Background="#E6F4EA" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#137333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="16,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="COMPLETED" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtBookingsCompleted" Text="0" FontSize="26" FontWeight="Bold" Foreground="#70000F" Margin="0,5,0,2"/>
                            <TextBlock Text="Returned rentals" FontSize="11" Foreground="#7A746D" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Width="35" Height="35" CornerRadius="9" Background="#F7E9EB" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#70000F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="8" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="16,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CANCELLED" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtBookingsCancelled" Text="0" FontSize="26" FontWeight="Bold" Foreground="#B42318" Margin="0,5,0,2"/>
                            <TextBlock Text="Cancelled reservations" FontSize="11" Foreground="#7A746D" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Width="35" Height="35" CornerRadius="9" Background="#FDEAEC" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#B42318" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: Operational Insights (Readiness & Today's Schedule) -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Fleet Readiness Card -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>

                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Fleet Readiness &amp; Status" FontSize="16" FontWeight="Bold" Foreground="#1F1D1B"/>
                                <TextBlock Text="Real-time availability distribution across current inventory" FontSize="12" Foreground="#7A746D" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#F7E9EB" CornerRadius="6" Padding="10,4">
                                <TextBlock x:Name="TxtFleetAvailRate" Text="0% Available" FontSize="12" FontWeight="Bold" Foreground="#70000F"/>
                            </Border>
                        </DockPanel>

                        <!-- Multi-color Segmented Distribution Bar -->
                        <Border Height="14" CornerRadius="7" Background="#F0EEEB" ClipToBounds="True" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColBarAvailable" Width="*"/>
                                    <ColumnDefinition x:Name="ColBarReserved" Width="*"/>
                                    <ColumnDefinition x:Name="ColBarRented" Width="*"/>
                                    <ColumnDefinition x:Name="ColBarMaintenance" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#16A34A" ToolTip="Available"/>
                                <Border Grid.Column="1" Background="#2563EB" ToolTip="Reserved"/>
                                <Border Grid.Column="2" Background="#70000F" ToolTip="Rented"/>
                                <Border Grid.Column="3" Background="#D97706" ToolTip="In Maintenance"/>
                            </Grid>
                        </Border>

                        <!-- Legend Metrics -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F9FAF9" BorderBrush="#E6EFE6" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Available" FontSize="11.5" FontWeight="SemiBold" Foreground="#5F5B56"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountAvailable" Text="0 vehicles" FontSize="14" FontWeight="Bold" Foreground="#137333"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F4F8FF" BorderBrush="#DAE7FC" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reserved" FontSize="11.5" FontWeight="SemiBold" Foreground="#5F5B56"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountReserved" Text="0 vehicles" FontSize="14" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FDF8F9" BorderBrush="#F7E4E7" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="#70000F" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Rented" FontSize="11.5" FontWeight="SemiBold" Foreground="#5F5B56"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountRented" Text="0 vehicles" FontSize="14" FontWeight="Bold" Foreground="#70000F"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#FEFBF7" BorderBrush="#FCEEDB" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Maintenance" FontSize="11.5" FontWeight="SemiBold" Foreground="#5F5B56"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCountMaintenance" Text="0 vehicles" FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Today's Dispatch Activity -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Today's Dispatch Activity" FontSize="16" FontWeight="Bold" Foreground="#1F1D1B"/>
                        <TextBlock x:Name="TxtDispatchSummary" Text="0 scheduled handoffs" FontSize="12" Foreground="#7A746D" Margin="0,2,0,16"/>

                        <!-- Pickups & Returns side-by-side -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F3F7FC" BorderBrush="#D6E5F7" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="PICKUPS" FontSize="10.5" FontWeight="Bold" Foreground="#1565C0"/>
                                    <TextBlock x:Name="TxtCountPickups" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,2,0,0"/>
                                    <TextBlock Text="Departures today" FontSize="11" Foreground="#7A746D"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F1F8F3" BorderBrush="#D2EBD7" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="RETURNS" FontSize="10.5" FontWeight="Bold" Foreground="#137333"/>
                                    <TextBlock x:Name="TxtCountReturns" Text="0" FontSize="20" FontWeight="Bold" Foreground="#137333" Margin="0,2,0,0"/>
                                    <TextBlock Text="Arrivals today" FontSize="11" Foreground="#7A746D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtDispatchStatusNote"
                                   Text="All daily handoffs are on schedule."
                                   FontSize="11.5" Foreground="#7A746D" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 3: Recent Reservations Table -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                </Border.Effect>

                <StackPanel>
                    <Border Padding="22,18,22,16" Background="White" BorderBrush="#E8E5E1" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Recent Active Bookings" FontSize="16" FontWeight="Bold" Foreground="#1F1D1B"/>
                                <TextBlock Text="Most recent customer reservations and their live status" FontSize="12" Foreground="#7A746D" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="DgRecent"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0EEEB"
                              BorderThickness="0"
                              Background="White"
                              AlternationCount="2"
                              ColumnHeaderStyle="{StaticResource ModernTableHeader}"
                              CellStyle="{StaticResource ModernTableCell}"
                              RowStyle="{StaticResource ModernTableRow}">

                        <DataGrid.Columns>
                            <!-- Reservation ID -->
                            <DataGridTemplateColumn Header="BOOKING ID" Width="102"
                                                    HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7E9EB" BorderBrush="#E7C0C7" BorderThickness="1"
                                                CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="11.5" Foreground="#70000F"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Customer with Avatar -->
                            <DataGridTemplateColumn Header="CUSTOMER" Width="2.0*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{Binding CustomerAvatarBg}">
                                                <TextBlock Text="{Binding CustomerInitials}" Foreground="{Binding CustomerAvatarFg}"
                                                           FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Customer}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Foreground="#2B2927"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Vehicle -->
                            <DataGridTemplateColumn Header="VEHICLE" Width="3.0*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,3">
                                            <TextBlock Text="{Binding Plate}" FontWeight="Bold" FontSize="10.5" Foreground="#77716B"/>
                                            <TextBlock Text="{Binding Vehicle}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="#2B2927" TextWrapping="Wrap" MaxWidth="360"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Dates -->
                            <DataGridTemplateColumn Header="RENTAL PERIOD" Width="1.85*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateRangeDisplay}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#2B2927"/>
                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="11" Foreground="#8C857B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total -->
                            <DataGridTemplateColumn Header="TOTAL" Width="1.05*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalDisplay}" FontSize="13" FontWeight="Bold" Foreground="#70000F" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="STATUS" Width="126"
                                                    HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding StatusBgColor}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#E2DFD9"/>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{Binding StatusDotColor}"/>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusUpper}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding StatusFgColor}"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
