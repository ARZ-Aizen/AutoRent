<UserControl x:Class="Presentation.Views.User.VehicleInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandMaroon" Color="#70000F"/>
            <SolidColorBrush x:Key="BrandMaroonHover" Color="#8A0016"/>

            <!-- Action buttons in header -->
            <Style x:Key="PrimaryActionBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandMaroon}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandMaroonHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom Header Style for DataGrid -->
            <Style x:Key="ModernTableHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F8F7F5"/>
                <Setter Property="Foreground" Value="#5C5750"/>
                <Setter Property="FontFamily" Value="Manrope, Segoe UI"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="BorderBrush" Value="#E8E5E1"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style x:Key="ModernTableHeaderCenter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ModernTableHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Custom Cell Style -->
            <Style x:Key="ModernTableCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FBF4F5"/>
                        <Setter Property="Foreground" Value="#70000F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Row Style -->
            <Style x:Key="ModernTableRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2B2927"/>
                <Setter Property="BorderBrush" Value="#F0EEEB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FCFBFA"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F7F4F1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Pagination button base -->
            <Style x:Key="PageBtn" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White"
                                    BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F6F5F3"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D0CBC5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom CheckBox Style -->
            <Style x:Key="InspectionCheckItem" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#2B2927"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Vehicle Inspection &amp; Quality Checks" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Record safety checks before dispatch &amp; after return · Failed checks automatically flag vehicle for maintenance"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>


            </DockPanel>

            <!-- ROW 1: 4 Metric Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Inspections -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL INSPECTIONS" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1F1D1B" Margin="0,4,0,2"/>
                            <TextBlock Text="All logged quality checks" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F4F3F1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2B2927"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Passed Inspections -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PASSED ROADWORTHY" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatPassed" Text="0" FontSize="26" FontWeight="Bold" Foreground="#137333" Margin="0,4,0,2"/>
                            <TextBlock Text="100% check passed" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E6F4EA" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#137333"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Needs Attention -->
                <Border Grid.Column="4" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FLAGGED DEFECTS" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatFailed" Text="0" FontSize="26" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,2"/>
                            <TextBlock Text="Failed inspection items" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FDF2F2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#C62828"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- In Maintenance -->
                <Border Grid.Column="6" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="IN MAINTENANCE" FontSize="11" FontWeight="Bold" Foreground="#8C857B"/>
                            <TextBlock x:Name="TxtStatMaint" Text="0" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,2"/>
                            <TextBlock Text="Vehicles under service" FontSize="11.5" Foreground="#7A746D"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FDEBDD" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#D97706"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: Two Column Layout (New Inspection Form on Left, History on Right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Record New Inspection Card -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12" Padding="22" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#F7E9EB" Margin="0,0,12,0">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#70000F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Record Vehicle Check" FontSize="16" FontWeight="Bold" Foreground="#1F1D1B"/>
                                <TextBlock Text="Select vehicle &amp; complete audit" FontSize="12" Foreground="#7A746D" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Vehicle Picker -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Target Vehicle" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbInspVehicle" Height="36" DisplayMemberPath="Display"/>
                        </StackPanel>

                        <!-- Inspector -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Inspector Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtInspector" Height="36" Tag="e.g. John Doe"/>
                        </StackPanel>

                        <!-- Fuel Level -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Fuel Gauge Level" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbFuel" Height="36"/>
                        </StackPanel>

                        <!-- Checklist -->
                        <Border Background="#F9F8F6" BorderBrush="#EAE6E1" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="INSPECTION CHECKLIST (CHECK = PASS)" FontSize="10.5" FontWeight="Bold" Foreground="#8C857B" Margin="0,0,0,10"/>

                                <CheckBox x:Name="ChkExterior" Content="Exterior (Body, Paint, Glass)" Style="{StaticResource InspectionCheckItem}"
                                          Checked="Checklist_Changed" Unchecked="Checklist_Changed"/>
                                <CheckBox x:Name="ChkTires" Content="Tires, Wheels &amp; Pressure" Style="{StaticResource InspectionCheckItem}"
                                          Checked="Checklist_Changed" Unchecked="Checklist_Changed"/>
                                <CheckBox x:Name="ChkLights" Content="Lights, Signals &amp; Horn" Style="{StaticResource InspectionCheckItem}"
                                          Checked="Checklist_Changed" Unchecked="Checklist_Changed"/>
                                <CheckBox x:Name="ChkInterior" Content="Interior, Seats &amp; Belts" Style="{StaticResource InspectionCheckItem}"
                                          Checked="Checklist_Changed" Unchecked="Checklist_Changed"/>
                                <CheckBox x:Name="ChkBrakes" Content="Braking System &amp; Fluid" Style="{StaticResource InspectionCheckItem}"
                                          Checked="Checklist_Changed" Unchecked="Checklist_Changed"/>
                                <CheckBox x:Name="ChkFluids" Content="Engine Oil &amp; Coolant" Style="{StaticResource InspectionCheckItem}"
                                          Margin="0" Checked="Checklist_Changed" Unchecked="Checklist_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Status Preview Banner -->
                        <Border x:Name="BorderCheckStatus" Background="#FDF2F2" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtCheckStatusIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#C62828" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCheckStatusText" Text="Unchecked items will set vehicle to Maintenance." FontSize="11.5" Foreground="#C62828" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Observations &amp; Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtInspNotes"
                                     Height="70"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6"
                                     Tag="Any scratches, dents or warning lights..."/>
                        </StackPanel>

                        <!-- Submit Button -->
                        <Button Content="Save Inspection"
                                Style="{StaticResource PrimaryActionBtn}"
                                Height="40"
                                Click="BtnSaveInspection_Click"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Inspection History & Filter Card -->
                <StackPanel Grid.Column="2">
                    <!-- Filters Bar -->
                    <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                            Padding="16,12" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Search Logs" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <TextBox x:Name="TxtSearchInsp" Height="36" Padding="32,0,10,0"
                                             VerticalContentAlignment="Center" FontSize="13"
                                             TextChanged="TxtSearchInsp_TextChanged"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#9E9892"
                                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="TxtSearchWatermark" Text="Search vehicle, inspector, or findings..."
                                               Foreground="#A39D96" FontSize="12.5" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="32,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Result Filter -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Result" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbResultFilter" Height="36" SelectionChanged="FilterInputs_Changed"/>
                            </StackPanel>

                            <!-- Reset Button -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button x:Name="BtnResetFilters" Content="Reset" Style="{StaticResource OutlineButton}"
                                        Height="36" Padding="14,0" Click="BtnResetFilters_Click"
                                        ToolTip="Reset search and filters"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Card -->
                    <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="12"
                            Padding="0" ClipToBounds="True" MinHeight="420">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>

                        <Grid>
                            <DataGrid x:Name="DgInspections"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F0EEEB"
                                      BorderThickness="0"
                                      Background="White"
                                      AlternationCount="2"
                                      ColumnHeaderStyle="{StaticResource ModernTableHeader}"
                                      CellStyle="{StaticResource ModernTableCell}"
                                      RowStyle="{StaticResource ModernTableRow}"
                                      SelectionMode="Single">

                                <DataGrid.Columns>
                                    <!-- Date -->
                                    <DataGridTemplateColumn Header="DATE &amp; TIME" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Vehicle -->
                                    <DataGridTemplateColumn Header="VEHICLE" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Vehicle}" FontWeight="Bold" FontSize="12.5" Foreground="#2B2927" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Inspector -->
                                    <DataGridTemplateColumn Header="INSPECTOR" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="#EEEBE7" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding InspectorInitials}" FontSize="10.5" FontWeight="Bold" Foreground="#5F5B56"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Inspector}" FontSize="12" Foreground="#2B2927" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Fuel -->
                                    <DataGridTemplateColumn Header="FUEL" Width="90"
                                                            HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F4F3F1" BorderBrush="#E0DDD9" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding FuelDisplay}" FontSize="11" FontWeight="Bold" Foreground="#5F5B56"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Result -->
                                    <DataGridTemplateColumn Header="RESULT" Width="140"
                                                            HeaderStyle="{StaticResource ModernTableHeaderCenter}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ResultBgColor}" BorderBrush="{Binding ResultBorderColor}" BorderThickness="1"
                                                        CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ResultIcon}" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                                                   Foreground="{Binding ResultFgColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ResultUpper}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{Binding ResultFgColor}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Findings -->
                                    <DataGridTemplateColumn Header="FINDINGS" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Findings}" FontSize="11.5" Foreground="#7A746D" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State -->
                            <Border x:Name="BorderEmptyState" Background="White" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="#F7F5F3" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A59F98"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No inspection logs found" FontSize="15" FontWeight="Bold" Foreground="#2B2927" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Try adjusting your search or result filter." FontSize="12.5" Foreground="#7A746D" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Pagination Card -->
                    <Border Background="White" BorderBrush="#E8E5E1" BorderThickness="1" CornerRadius="14"
                            Padding="24,12" Margin="0,16,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtPaging" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#A59F98"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnPrev" Style="{StaticResource PageBtn}" Click="BtnPrev_Click" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D"/>
                                </Button>

                                <ItemsControl x:Name="IcPages">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Button x:Name="BtnNext" Style="{StaticResource PageBtn}" Click="BtnNext_Click">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7A746D"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
