
<UserControl x:Class="Presentation.Views.User.VehicleInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Manrope, Segoe UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClientStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main page: fill the available content area -->
    <Grid Margin="30,24,30,24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Page heading -->
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,20">

            <TextBlock Text="Vehicle Inspection"
                       Style="{StaticResource PageTitle}"
                       TextWrapping="Wrap"/>

            <TextBlock
                Text="Record a vehicle check. A failed check marks the vehicle as Maintenance."
                Style="{StaticResource PageSubtitle}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Left: inspection form -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource Card}"
                Margin="0,0,20,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <TextBlock Text="Vehicle"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="CmbInspVehicle"
                              Tag="Select vehicle"
                              DisplayMemberPath="Display"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Inspector"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtInspector"
                             Tag="Inspector's name"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Checklist (tick = ok)"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,4"/>

                    <CheckBox x:Name="ChkExterior"
                              Content="Exterior (body, paint, glass)"
                              Margin="0,2"/>

                    <CheckBox x:Name="ChkTires"
                              Content="Tires and wheels"
                              Margin="0,2"/>

                    <CheckBox x:Name="ChkLights"
                              Content="Lights and signals"
                              Margin="0,2"/>

                    <CheckBox x:Name="ChkInterior"
                              Content="Interior and seats"
                              Margin="0,2"/>

                    <CheckBox x:Name="ChkBrakes"
                              Content="Brakes"
                              Margin="0,2"/>

                    <CheckBox x:Name="ChkFluids"
                              Content="Engine oil and fluids"
                              Margin="0,2"/>

                    <TextBlock Text="Fuel level"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,4"/>

                    <ComboBox x:Name="CmbFuel"
                              SelectedIndex="0"
                              Margin="0,0,0,12">

                        <ComboBoxItem Content="Full"/>
                        <ComboBoxItem Content="3/4"/>
                        <ComboBoxItem Content="1/2"/>
                        <ComboBoxItem Content="1/4"/>
                        <ComboBoxItem Content="Empty"/>

                    </ComboBox>

                    <TextBlock Text="Notes"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TxtInspNotes"
                             Tag="Scratches, warning lights, anything unusual…"
                             MinHeight="75"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Padding="8,6"
                             Margin="0,0,0,16"/>

                    <Button Content="Save inspection"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSaveInspection_Click"
                            HorizontalAlignment="Stretch"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right: inspection history fills remaining space -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              MinWidth="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Inspection history"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1"
                    Style="{StaticResource GridCard}"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <DataGrid x:Name="DgInspections"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          MinWidth="0">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Date"
                            Binding="{Binding InspectedOn, StringFormat='MMM dd, h:mm tt'}"
                            Width="1.2*"/>

                        <DataGridTextColumn
                            Header="Vehicle"
                            Binding="{Binding Vehicle}"
                            Width="1.5*"/>

                        <DataGridTextColumn
                            Header="Inspector"
                            Binding="{Binding Inspector}"
                            Width="1.2*"/>

                        <DataGridTextColumn
                            Header="Fuel"
                            Binding="{Binding Fuel}"
                            Width="0.7*"/>

                        <DataGridTextColumn
                            Header="Findings"
                            Binding="{Binding Findings}"
                            Width="1.5*"/>

                        <DataGridTemplateColumn
                            Header="Result"
                            SortMemberPath="Result"
                            Width="1*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl
                                        Content="{Binding Result}"
                                        ContentTemplate="{StaticResource StatusPill}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
